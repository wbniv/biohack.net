---
interface Props { deckUrl: string; exitUrl: string; storageKey: string; expectedCards: number; }
const { deckUrl, exitUrl, storageKey, expectedCards } = Astro.props;
---
<div class="app" id="review-app">
  <header class="bar"><a href={exitUrl} aria-label="Exit focused review">× <span>Exit</span></a><div id="session-count">Loading…</div><button id="open-settings" aria-label="Open review settings">⚙</button></header>
  <main>
    <button class="stage" id="stage" aria-label="Reveal answer" disabled>
      <span class="eyebrow">Spanish · Recognition</span><span class="prompt" id="prompt">cargando…</span>
      <span class="answer" id="answer" hidden><span class="divider"></span><span class="meaning" id="meaning"></span><span class="example-es" id="example-es"></span><span class="example-en" id="example-en"></span><span class="grammar" id="grammar"></span></span>
    </button>
    <section class="summary" id="summary" hidden><p>Session complete</p><h1><span id="summary-reviewed">0</span> cards reviewed</h1><dl><div><dt>Remembered</dt><dd id="summary-good">0</dd></div><div><dt>Relearning</dt><dd id="summary-again">0</dd></div></dl><p id="next-due"></p><button id="continue-new">Continue with 20 new cards</button><a href={exitUrl}>Finish session</a></section>
  </main>
  <footer id="actions"><button class="reveal" id="reveal" disabled>Show answer</button><div class="grades" id="grades" hidden><button class="again" id="again"><span>👎</span><strong>Again</strong><small>repeat soon</small></button><button class="good" id="good"><span>👍</span><strong>Got it</strong><small>longer interval</small></button></div></footer>
  <div class="sr-only" id="announcement" aria-live="polite"></div>
  <dialog id="settings"><form method="dialog"><div class="dialog-heading"><h2>Review settings</h2><button value="close" aria-label="Close settings">×</button></div><label for="new-limit">New cards this session</label><select id="new-limit"><option>10</option><option selected>20</option><option>30</option><option>50</option></select><label class="check"><input id="tap-reveal" type="checkbox" checked> Tap card to reveal</label><button class="skip" id="skip" type="button">Skip this card</button><p>Progress is saved only in this browser. Use Anki for synchronization across devices.</p><button class="reset" id="reset" type="button">Reset review progress</button></form></dialog>
</div>

<script define:vars={{ deckUrl, storageKey, expectedCards }}>
  const SETTINGS_KEY=`${storageKey}:settings`, RETRY=120000, GAP=7;
  const stage=document.querySelector('#stage'), answer=document.querySelector('#answer'), reveal=document.querySelector('#reveal'), grades=document.querySelector('#grades'), actions=document.querySelector('#actions'), summary=document.querySelector('#summary'), dialog=document.querySelector('#settings');
  let cards=[],current=null,recent=[],session={reviewed:0,good:0,again:0,newIntroduced:0};
  function loadJSON(key,fallback){try{return JSON.parse(localStorage.getItem(key)||'null')||fallback}catch{return fallback}}
  let settings={newLimit:20,tapReveal:true,...loadJSON(SETTINGS_KEY,{})};
  const stored=loadJSON(storageKey,{}); let serial=Number.isFinite(stored.serial)?stored.serial:0;
  let progress=stored.cards&&typeof stored.cards==='object'?Object.fromEntries(Object.entries(stored.cards).filter(([,s])=>s&&Number.isFinite(s.due)&&Number.isFinite(s.reps))):{};
  const save=()=>localStorage.setItem(storageKey,JSON.stringify({serial,cards:progress}));
  const saveSettings=()=>localStorage.setItem(SETTINGS_KEY,JSON.stringify(settings));
  function decode(value){const t=document.createElement('textarea');t.innerHTML=value;return t.value}
  function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
  const stateFor=id=>progress[id]||{reps:0,lapses:0,interval:0,ease:2.35,due:0,lastReview:0,eligibleSerial:0};
  function choose({skip=false,allowNew=true}={}){const now=Date.now(),eligible=cards.filter(c=>!recent.includes(c.id)&&(!skip||c.id!==current?.id));const due=eligible.filter(c=>progress[c.id]&&progress[c.id].due<=now&&(progress[c.id].eligibleSerial||0)<=serial).sort((a,b)=>progress[a.id].due-progress[b.id].due);if(due.length)return due[0];if(allowNew&&session.newIntroduced<settings.newLimit){const unseen=eligible.filter(c=>!progress[c.id]);if(unseen.length)return unseen[Math.floor(Math.random()*unseen.length)]}return null}
  const dueCount=()=>Object.values(progress).filter(s=>s.due<=Date.now()&&(s.eligibleSerial||0)<=serial).length;
  function show(c){if(!c)return showSummary();current=c;if(!progress[c.id])session.newIntroduced++;document.querySelector('#prompt').textContent=c.spanish;document.querySelector('#meaning').textContent=c.english;document.querySelector('#example-es').textContent=c.es;document.querySelector('#example-en').textContent=c.en;document.querySelector('#grammar').textContent=c.grammar;document.querySelector('#session-count').textContent=`${dueCount()} due · ${session.reviewed} reviewed`;answer.hidden=true;grades.hidden=true;reveal.hidden=false;reveal.disabled=false;stage.disabled=false;stage.hidden=false;actions.hidden=false;summary.hidden=true;stage.setAttribute('aria-label','Reveal answer');requestAnimationFrame(()=>reveal.focus({preventScroll:true}));document.querySelector('#announcement').textContent=`New card: ${c.spanish}`}
  function revealAnswer(){if(!current||!answer.hidden)return;answer.hidden=false;reveal.hidden=true;grades.hidden=false;stage.setAttribute('aria-label','Answer revealed');requestAnimationFrame(()=>document.querySelector('#again').focus({preventScroll:true}))}
  function grade(ok){const now=Date.now(),s=stateFor(current.id);serial++;session.reviewed++;if(ok){session.good++;const base=s.reps===0?1:s.reps===1?3:Math.max(4,s.interval*s.ease);s.interval=Math.max(1,Math.round(base*(.95+Math.random()*.1)));s.reps++;s.ease=Math.min(2.7,s.ease+.04);s.due=now+s.interval*86400000;s.eligibleSerial=serial}else{session.again++;s.lapses++;s.reps=Math.max(0,s.reps-1);s.interval=0;s.ease=Math.max(1.3,s.ease-.2);s.due=now+RETRY;s.eligibleSerial=serial+GAP}s.lastReview=now;progress[current.id]=s;save();recent.push(current.id);recent=recent.slice(-GAP);show(choose({skip:true}))}
  function nextDue(){const future=Object.values(progress).map(s=>s.due).filter(d=>d>Date.now()).sort((a,b)=>a-b)[0];if(!future)return'No scheduled reviews yet.';const m=Math.max(1,Math.ceil((future-Date.now())/60000));return m<60?`Next card due in ${m}m.`:m<1440?`Next card due in ${Math.ceil(m/60)}h.`:`Next card due in ${Math.ceil(m/1440)}d.`}
  function showSummary(){stage.hidden=true;actions.hidden=true;summary.hidden=false;document.querySelector('#summary-reviewed').textContent=session.reviewed;document.querySelector('#summary-good').textContent=session.good;document.querySelector('#summary-again').textContent=session.again;document.querySelector('#next-due').textContent=nextDue();document.querySelector('#session-count').textContent='Session complete';document.querySelector('#continue-new').focus({preventScroll:true})}
  reveal.addEventListener('click',revealAnswer);stage.addEventListener('click',()=>settings.tapReveal&&revealAnswer());document.querySelector('#again').addEventListener('click',()=>grade(false));document.querySelector('#good').addEventListener('click',()=>grade(true));document.querySelector('#open-settings').addEventListener('click',()=>dialog.showModal());
  document.querySelector('#skip').addEventListener('click',()=>{dialog.close();recent.push(current.id);recent=recent.slice(-GAP);show(choose({skip:true}))});document.querySelector('#continue-new').addEventListener('click',()=>{settings.newLimit+=20;saveSettings();show(choose({skip:true}))});
  document.querySelector('#reset').addEventListener('click',()=>{if(!confirm('Reset all Spanish browser-review progress on this device?'))return;progress={};serial=0;recent=[];session={reviewed:0,good:0,again:0,newIntroduced:0};localStorage.removeItem(storageKey);dialog.close();show(choose({skip:true}))});
  const limit=document.querySelector('#new-limit');limit.value=String(settings.newLimit);limit.addEventListener('change',()=>{settings.newLimit=Number(limit.value);saveSettings()});const tap=document.querySelector('#tap-reveal');tap.checked=settings.tapReveal;tap.addEventListener('change',()=>{settings.tapReveal=tap.checked;saveSettings()});
  document.addEventListener('keydown',e=>{if(dialog.open)return;if(e.code==='Space'&&answer.hidden){e.preventDefault();revealAnswer()}if(!answer.hidden&&e.key==='1')grade(false);if(!answer.hidden&&e.key==='2')grade(true)});
  fetch(deckUrl).then(r=>{if(!r.ok)throw Error(r.status);return r.text()}).then(text=>{cards=shuffle(text.split(/\r?\n/).filter(l=>l&&!l.startsWith('#')).map(l=>l.split('\t')).filter(f=>f.length>=9).map(f=>({id:f[0],spanish:decode(f[1]),english:decode(f[2]),es:decode(f[3]),en:decode(f[4]),grammar:decode(f[5])})));if(cards.length!==expectedCards)throw Error(`Expected ${expectedCards}, loaded ${cards.length}`);show(choose())}).catch(e=>{console.error(e);document.querySelector('#prompt').textContent='Deck unavailable';document.querySelector('#session-count').textContent='Load failed'});
</script>

<style>
  .app{--bg:#171717;--surface:#211f1c;--ink:#f4f1ea;--muted:#bdb8ae;--rule:#504b43;--accent:#e6b566;background:var(--bg);color:var(--ink);display:grid;grid-template-rows:auto minmax(0,1fr) auto;height:100dvh;overflow:hidden;padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
  .bar{align-items:center;border-bottom:1px solid var(--rule);display:grid;grid-template-columns:1fr auto 1fr;min-height:54px;padding:0 .8rem}.bar a{color:var(--muted);font:700 .72rem/1 'JetBrains Mono',monospace;text-decoration:none;text-transform:uppercase}.bar div{color:var(--muted);font:700 .66rem/1 'JetBrains Mono',monospace;text-align:center;text-transform:uppercase}.bar button{background:none;border:0;color:var(--accent);font-size:1rem;justify-self:end;min-height:44px;min-width:44px}
  main{min-height:0;overflow:hidden;padding:.65rem}.stage{background:transparent;border:0;color:inherit;display:flex;flex-direction:column;height:100%;margin:0 auto;max-width:560px;overflow-y:auto;padding:clamp(1rem,5vw,2rem);text-align:center;width:100%}.eyebrow{color:var(--muted);font:700 .65rem/1.2 'JetBrains Mono',monospace;letter-spacing:.13em;text-transform:uppercase}.prompt{color:var(--accent);font-size:clamp(2.35rem,12vw,4.5rem);font-weight:750;letter-spacing:-.04em;line-height:1.05;margin:auto 0}.answer{display:flex;flex-direction:column}.answer[hidden]{display:none}.stage:has(.answer:not([hidden])) .prompt{font-size:clamp(1.8rem,8vw,3rem);margin:clamp(1rem,5vh,2.5rem) 0}.divider{border-top:1px solid var(--rule);margin:0 0 1.25rem}.meaning{font-size:clamp(1.35rem,6vw,2rem);font-weight:700}.example-es{font-size:clamp(1rem,4.5vw,1.25rem);font-weight:600;margin-top:1.5rem;text-align:left}.example-en{color:var(--muted);font-size:clamp(.9rem,4vw,1.1rem);margin-top:.25rem;text-align:left}.grammar{color:var(--accent);font:700 .65rem/1.2 'JetBrains Mono',monospace;letter-spacing:.1em;margin-top:1.3rem;text-align:left;text-transform:uppercase}
  footer{border-top:1px solid var(--rule);min-height:84px;padding:.75rem}.reveal{background:var(--accent);border:0;border-radius:13px;color:#1b1814;display:block;font-weight:800;height:56px;margin:0 auto;max-width:560px;width:100%}.grades{display:grid;gap:.65rem;grid-template-columns:1fr 1fr;margin:0 auto;max-width:560px}.grades[hidden]{display:none}.grades button{align-items:center;border-radius:13px;display:grid;gap:.1rem .55rem;grid-template-columns:auto 1fr;min-height:60px;padding:.55rem .8rem;text-align:left}.grades button>span{font-size:1.25rem;grid-row:1/3}.grades strong{font-size:.9rem}.grades small{font-size:.65rem}.again{background:var(--surface);border:1px solid var(--rule);color:var(--ink)}.again small{color:var(--muted)}.good{background:#3d805c;border:1px solid #4b9a70;color:white}.good small{color:#d3e6d9}
  .summary{align-items:center;display:flex;flex-direction:column;height:100%;justify-content:center;margin:0 auto;max-width:520px;text-align:center}.summary[hidden]{display:none}.summary>p:first-child{color:var(--accent);font:700 .7rem/1 'JetBrains Mono',monospace;text-transform:uppercase}.summary h1{font-size:clamp(2rem,9vw,3.5rem);margin:.8rem 0 1.5rem}.summary dl{display:flex;gap:2.5rem}.summary dl div{display:flex;flex-direction:column-reverse}.summary dt,#next-due{color:var(--muted)}.summary dd{color:var(--accent);font-size:1.6rem;font-weight:800;margin:0}#continue-new{background:var(--accent);border:0;border-radius:12px;color:#1b1814;font-weight:800;min-height:52px;padding:.75rem 1rem;width:min(100%,320px)}.summary a{color:var(--muted);margin-top:1rem;padding:.75rem}
  dialog{background:var(--surface);border:1px solid var(--rule);border-radius:18px 18px 0 0;color:var(--ink);margin:auto 0 0;max-width:none;padding:0;width:100%}dialog::backdrop{background:#000a}dialog form{display:grid;gap:1rem;margin:0 auto;max-width:560px;padding:1.25rem}.dialog-heading{align-items:center;display:flex;justify-content:space-between}.dialog-heading h2{font-size:1.25rem;margin:0}.dialog-heading button{background:none;border:0;color:var(--muted);font-size:1.5rem}.check{align-items:center;display:flex;gap:.65rem;min-height:44px}dialog select,.skip,.reset{background:var(--bg);border:1px solid var(--rule);border-radius:8px;color:var(--ink);min-height:44px;padding:.5rem}.reset{border-color:#a85045;color:#eea79f}dialog p,dialog label{color:var(--muted);font-size:.8rem}.sr-only{clip:rect(0,0,0,0);height:1px;overflow:hidden;position:absolute;width:1px}button:focus-visible,a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
  @media(prefers-color-scheme:light){.app{--bg:#f3efe7;--surface:#fffdf8;--ink:#211d18;--muted:#766e64;--rule:#d8d0c3;--accent:#a74830}.reveal,#continue-new{color:white}}
</style>
