---
interface Props { deckUrl: string; exitUrl: string; storageKey: string; expectedCards: number; }
const { deckUrl, exitUrl, storageKey, expectedCards } = Astro.props;
---
<div class="app">
  <header><a href={exitUrl}>× <span>Exit</span></a><span id="status">Loading…</span><button id="settings-button" aria-label="Settings">⚙</button></header>
  <main>
    <div id="card" class="card" role="button" tabindex="0" aria-label="Reveal answer">
      <span id="mode" class="eyebrow">TH · SAY IT</span>
      <span id="prompt" class="prompt">กำลังโหลด…</span>
      <span id="listen-prompt" class="listen-prompt" hidden><span aria-hidden="true">▶</span><small>Tap to hear</small></span>
      <span id="answer" class="answer" hidden>
        <span class="rule"></span><b id="thai" lang="th"></b><span id="english"></span><small id="usage"></small>
        <span class="audio-row"><button type="button" id="hear">▶ Hear</button><button type="button" id="slow">▶ Slow 0.8×</button></span>
      </span>
      <section id="coach" class="coach" aria-label="Pronunciation visualization">
        <span class="coach-title">Pronunciation · mouth + tone</span>
        <svg class="mouth-map" viewBox="0 0 300 190" role="img" aria-label="Side view showing lips, tongue, palate, throat, and airflow">
          <path class="head" d="M27 91C37 35 105 12 172 36c40 15 56 55 42 95-6 16-18 29-33 37H76C39 157 17 126 27 91Z"/>
          <path class="palate" d="M54 79c48-28 99-23 133 12"/><path class="teeth" d="M50 94h42"/><path class="mouth" d="M29 95c19-11 36-10 54 1-18 10-35 9-54-1Z"/>
          <path class="tongue" d="M57 117c50 28 97 16 130-24"/><path class="throat" d="M195 89c-8 34-3 58 15 78"/><path class="air" d="M12 95h145"/><circle class="contact" cx="162" cy="90" r="7"/>
          <text x="25" y="145">lips</text><text x="108" y="151">tongue</text><text x="190" y="181">throat</text><text x="120" y="69">palate</text>
        </svg>
        <span class="tone-map"><small>tone</small><svg viewBox="0 0 180 60" aria-label="Simplified pitch contour"><path d="M5 46 C42 49 68 14 105 25 S148 46 175 12"/><circle cx="5" cy="46" r="4"/><circle cx="175" cy="12" r="4"/></svg><span class="timing"><small>vowel timing</small><i></i><i class="long"></i></span></span>
        <span id="coach-text"></span>
      </section>
    </div>
  </main>
  <footer><button id="reveal" class="reveal" disabled>Show answer</button><div id="grades" class="grades" hidden><button id="again">👎 <b>Again</b><small>repeat soon</small></button><button id="good">👍 <b>Got it</b><small>longer interval</small></button></div></footer>
  <dialog id="settings"><form method="dialog"><div><h2>Thai practice</h2><button aria-label="Close">×</button></div><label><input id="autoplay" type="checkbox"> Auto-play revealed answers</label><label><input id="listening" type="checkbox" checked> Include listening cards</label><p id="voice-state">Checking this phone for a Thai voice…</p><p>Thai script and its pronunciation visualization are always shown together. Progress stays in this browser.</p><button type="button" id="reset" class="reset">Reset Thai progress</button></form></dialog>
  <span id="announce" class="sr-only" aria-live="polite"></span>
</div>

<script define:vars={{ deckUrl, storageKey, expectedCards }}>
  const RETRY=120000,GAP=7,settingsKey=`${storageKey}:preferences:v1`;
  const $=s=>document.querySelector(s), card=$('#card'), answer=$('#answer'), grades=$('#grades'), reveal=$('#reveal'), dialog=$('#settings');
  let cards=[],current,voices=[],recent=[],serial=0,progress={},session=0,direction='produce';
  function json(key,fallback){try{return JSON.parse(localStorage.getItem(key)||'null')||fallback}catch{return fallback}}
  let prefs={autoplay:false,listening:true,...json(settingsKey,{})};
  const stored=json(storageKey,{}); serial=Number(stored.serial)||0;progress=stored.cards||{};
  const save=()=>localStorage.setItem(storageKey,JSON.stringify({serial,cards:progress}));
  const savePrefs=()=>localStorage.setItem(settingsKey,JSON.stringify(prefs));
  function shuffle(a){for(let i=a.length-1;i;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
  function loadVoices(){voices=speechSynthesis?.getVoices?.().filter(v=>v.lang.toLowerCase().startsWith('th'))||[];$('#voice-state').textContent=voices.length?`Thai audio available: ${voices[0].name}`:'No Thai system voice found. Text and mouth guidance still work.'}
  if('speechSynthesis' in window){loadVoices();speechSynthesis.addEventListener('voiceschanged',loadVoices)}
  function speak(rate=1){if(!current||!('speechSynthesis' in window))return; speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(current.thai);u.lang='th-TH';u.rate=rate;if(voices[0])u.voice=voices[0];speechSynthesis.speak(u)}
  function choose(){const eligible=cards.filter(c=>!recent.includes(c.id)&&c.id!==current?.id),now=Date.now();const due=eligible.filter(c=>progress[c.id]?.due<=now&&(progress[c.id]?.eligibleSerial||0)<=serial).sort((a,b)=>progress[a.id].due-progress[b.id].due);const pool=due.length?due:eligible.filter(c=>!progress[c.id]);return pool[Math.floor(Math.random()*pool.length)]||eligible[0]||cards[0]}
  function setDirection(){const options=prefs.listening?['produce','recognize','listen']:['produce','recognize'];direction=options[Math.floor(Math.random()*options.length)]}
  function show(c){current=c;setDirection();answer.hidden=true;grades.hidden=true;reveal.hidden=false;$('#listen-prompt').hidden=direction!=='listen';$('#prompt').hidden=direction==='listen';$('#mode').textContent=direction==='produce'?'TH · SAY IT':direction==='recognize'?'TH · RECOGNIZE':'TH · LISTENING';$('#prompt').textContent=direction==='produce'?c.english:c.thai;$('#thai').textContent=c.thai;$('#english').textContent=c.english;$('#usage').textContent=c.usage;$('#coach-text').textContent=c.coach;$('#coach').hidden=direction!=='recognize';$('#status').textContent=`${session} reviewed · ${cards.length-Object.keys(progress).length} new`;card.disabled=false;reveal.disabled=false;if(direction==='listen')setTimeout(()=>speak(),100)}
  function revealAnswer(){if(!current||!answer.hidden)return;answer.hidden=false;$('#coach').hidden=false;reveal.hidden=true;grades.hidden=false;card.setAttribute('aria-label','Answer revealed');if(prefs.autoplay&&direction!=='listen')speak();$('#again').focus({preventScroll:true})}
  function grade(ok){const now=Date.now(),s=progress[current.id]||{reps:0,lapses:0,interval:0,ease:2.35};serial++;session++;if(ok){const base=s.reps===0?1:s.reps===1?3:Math.max(4,s.interval*s.ease);s.interval=Math.max(1,Math.round(base));s.reps++;s.ease=Math.min(2.7,s.ease+.04);s.due=now+s.interval*86400000;s.eligibleSerial=serial}else{s.lapses++;s.reps=Math.max(0,s.reps-1);s.interval=0;s.ease=Math.max(1.3,s.ease-.2);s.due=now+RETRY;s.eligibleSerial=serial+GAP}progress[current.id]=s;save();recent.push(current.id);recent=recent.slice(-GAP);show(choose())}
  card.addEventListener('click',e=>{if(e.target.closest('button'))return;direction==='listen'&&answer.hidden?speak():revealAnswer()});card.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&answer.hidden){e.preventDefault();revealAnswer()}});reveal.addEventListener('click',revealAnswer);$('#again').addEventListener('click',()=>grade(false));$('#good').addEventListener('click',()=>grade(true));$('#hear').addEventListener('click',()=>speak());$('#slow').addEventListener('click',()=>speak(.8));$('#listen-prompt').addEventListener('click',e=>{e.stopPropagation();speak()});$('#settings-button').addEventListener('click',()=>dialog.showModal());
  for(const [id,key] of [['autoplay','autoplay'],['listening','listening']]){$(`#${id}`).checked=prefs[key];$(`#${id}`).addEventListener('change',e=>{prefs[key]=e.target.checked;savePrefs()})}
  $('#reset').addEventListener('click',()=>{if(!confirm('Reset all Thai review progress on this device?'))return;progress={};serial=0;recent=[];session=0;localStorage.removeItem(storageKey);dialog.close();show(choose())});
  fetch(deckUrl).then(r=>r.ok?r.text():Promise.reject(Error(r.status))).then(text=>{cards=shuffle(text.split(/\r?\n/).filter(l=>l&&!l.startsWith('#')).map(l=>l.split('\t')).map(f=>({id:f[0],thai:f[1],english:f[2],usage:f[3],coach:f[4],tags:f[5]})));if(cards.length!==expectedCards)throw Error(`Expected ${expectedCards}, loaded ${cards.length}`);show(choose())}).catch(e=>{$('#prompt').hidden=false;$('#prompt').textContent='Deck unavailable';$('#status').textContent='Load failed';console.error(e)});
</script>

<style>
  .app{--bg:#151514;--surface:#24221e;--ink:#faf6ed;--muted:#bdb5a7;--rule:#514b41;--gold:#edb95e;background:var(--bg);color:var(--ink);display:grid;grid-template-rows:54px minmax(0,1fr) auto;height:100dvh;overflow:hidden;padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
  header{align-items:center;border-bottom:1px solid var(--rule);display:grid;grid-template-columns:1fr auto 1fr;padding:0 .8rem}header a{color:var(--muted);font:700 .72rem monospace;text-decoration:none;text-transform:uppercase}header>span{color:var(--muted);font:700 .64rem monospace;text-transform:uppercase}header button{background:none;border:0;color:var(--gold);font-size:1rem;justify-self:end;min-height:44px;min-width:44px}
  main{min-height:0;padding:.6rem}.card{background:none;border:0;color:inherit;display:flex;flex-direction:column;height:100%;margin:auto;max-width:580px;overflow-y:auto;padding:clamp(1rem,5vw,2rem);text-align:center;width:100%}.eyebrow{color:var(--muted);font:700 .65rem monospace;letter-spacing:.12em}.prompt{color:var(--gold);font-size:clamp(2.4rem,13vw,5rem);font-weight:750;line-height:1.1;margin:auto 0}.prompt[hidden],.listen-prompt[hidden]{display:none}.listen-prompt{align-items:center;color:var(--gold);display:flex;flex-direction:column;font-size:4.5rem;gap:.5rem;margin:auto}.listen-prompt small{color:var(--muted);font:700 .7rem monospace;text-transform:uppercase}.answer{display:flex;flex-direction:column}.answer[hidden]{display:none}.card:has(.answer:not([hidden])) .prompt{font-size:clamp(1.5rem,7vw,2.7rem);margin:1rem 0}.rule{border-top:1px solid var(--rule);margin-bottom:1.1rem}.answer>b{font:750 clamp(2.2rem,12vw,4.5rem)/1.25 system-ui}.answer>span:not(.rule,.audio-row){font-size:1.2rem}.answer>small{color:var(--muted);margin-top:.35rem}.audio-row{display:flex;gap:.6rem;justify-content:center;margin:.75rem}.audio-row button{background:var(--surface);border:1px solid var(--rule);border-radius:999px;color:var(--ink);min-height:42px;padding:.5rem 1rem}.coach{background:var(--surface);border:1px solid var(--rule);border-radius:16px;display:grid;gap:.5rem;grid-template-columns:minmax(150px,1.5fr) minmax(110px,1fr);margin:.5rem 0 1rem;padding:.8rem;text-align:left}.coach[hidden]{display:none}.coach-title{color:var(--gold);font:700 .62rem monospace;grid-column:1/-1;text-transform:uppercase}.mouth-map{height:150px;width:100%}.head{fill:#34302a;stroke:#8f8678;stroke-width:2}.palate,.teeth,.throat{fill:none;stroke:#d8d0c3;stroke-width:4}.mouth{fill:#d77b6f}.tongue{fill:none;stroke:var(--gold);stroke-linecap:round;stroke-width:11}.air{fill:none;stroke:#7bc6c6;stroke-dasharray:6 7;stroke-width:4}.contact{fill:#ef735f}.coach text{fill:#aaa194;font-size:11px}.tone-map{align-self:center;display:flex;flex-direction:column}.tone-map>small,.timing small{color:var(--muted);font:700 .58rem monospace;text-transform:uppercase}.tone-map svg{height:58px;width:100%}.tone-map path{fill:none;stroke:var(--gold);stroke-width:4}.tone-map circle{fill:var(--gold)}.timing{display:grid;gap:.25rem;grid-template-columns:1fr 1.8fr}.timing small{grid-column:1/-1}.timing i{background:#7bc6c6;border-radius:2px;height:5px}.coach>#coach-text{color:var(--ink);font-size:.8rem;grid-column:1/-1;line-height:1.4}
  footer{border-top:1px solid var(--rule);padding:.75rem}.reveal{background:var(--gold);border:0;border-radius:13px;color:#1b1814;display:block;font-weight:800;height:56px;margin:auto;max-width:580px;width:100%}.grades{display:grid;gap:.65rem;grid-template-columns:1fr 1fr;margin:auto;max-width:580px}.grades[hidden]{display:none}.grades button{background:var(--surface);border:1px solid var(--rule);border-radius:13px;color:var(--ink);display:grid;grid-template-columns:auto 1fr;min-height:60px;text-align:left}.grades small{color:var(--muted)}#good{background:#397c58;border-color:#4a9a70}
  dialog{background:var(--surface);border:1px solid var(--rule);border-radius:18px 18px 0 0;color:var(--ink);margin:auto 0 0;max-width:none;width:100%}dialog::backdrop{background:#000a}dialog form{display:grid;gap:1rem;margin:auto;max-width:560px;padding:1.25rem}dialog form>div{align-items:center;display:flex;justify-content:space-between}dialog h2{margin:0}dialog label{min-height:38px}dialog p{color:var(--muted);font-size:.8rem}.reset{background:none;border:1px solid #a85045;border-radius:8px;color:#eea79f;min-height:44px}.mouth-dialog{border-radius:0;height:100dvh;margin:0;max-height:none;padding:0}.mouth-sheet{display:flex;flex-direction:column;height:100%;margin:auto;max-width:620px;padding:env(safe-area-inset-top) 1rem env(safe-area-inset-bottom)}.mouth-sheet>header{border:0;display:flex;min-height:76px;padding:0}.mouth-sheet header div{display:flex;flex-direction:column}.mouth-sheet header small{color:var(--gold);font:700 .65rem monospace;text-transform:uppercase}.mouth-sheet header b{font-size:clamp(2rem,10vw,3.5rem)}.mouth-sheet header button{color:var(--ink);font-size:2rem}.mouth-visual{display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) 150px;margin:auto 0}.mouth-visual>svg{max-height:310px;width:100%}.face{fill:#302d28;stroke:#8f8678;stroke-width:2}.palate,.teeth,.throat{fill:none;stroke:#d8d0c3;stroke-width:6}.lips{fill:#d77b6f}.tongue-large{fill:none;stroke:var(--gold);stroke-linecap:round;stroke-width:18}.air-large{fill:none;stroke:#7bc6c6;stroke-dasharray:8 10;stroke-width:5}.contact{fill:#ef735f}.mouth-visual text{fill:var(--muted);font-size:15px}.tone-panel{align-self:center}.tone-panel small{color:var(--muted);font:700 .65rem monospace;text-transform:uppercase}.tone-panel svg{width:100%}.tone-panel path{fill:none;stroke:var(--gold);stroke-width:5}.tone-panel circle{fill:var(--gold)}.length{align-items:center;color:var(--muted);display:grid;font:600 .6rem monospace;gap:.3rem;grid-template-columns:auto 1fr}.length i{background:#7bc6c6;border-radius:2px;height:5px}.length .long{grid-column:2;width:100%}.mouth-sheet>#mouth-help{font-size:1.05rem;line-height:1.5;margin:1rem 0}.mouth-actions{display:grid;gap:.6rem;grid-template-columns:1fr 1fr}.mouth-actions button{background:var(--gold);border:0;border-radius:12px;color:#1b1814;font-weight:800;min-height:52px}.coach-note{color:var(--muted);font-size:.72rem;line-height:1.4}.sr-only{clip:rect(0,0,0,0);height:1px;overflow:hidden;position:absolute;width:1px}
  @media(max-width:480px){.mouth-map{height:130px}.coach{grid-template-columns:minmax(145px,1.45fr) minmax(95px,1fr)}}@media(max-height:700px){.mouth-map{height:105px}.coach{margin:.25rem 0;padding:.55rem}.coach>#coach-text{font-size:.72rem}.answer>b{font-size:clamp(1.8rem,9vw,3rem)}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
