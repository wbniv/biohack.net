---
/**
 * Language-neutral Cast receiver URL — this path is what gets bound to the
 * Custom Receiver application ID in the Cast Developer Console, so it must
 * never encode a language (plan decision 7).
 *
 * The production route is registered as Custom Receiver application 27730439.
 * CastReceiver retains its browser simulator behind a prop for local QA, but
 * this route starts the real Cast Application Framework receiver.
 */
import Base from '../../../layouts/Base.astro';
import CastReceiver from '../../../components/languages/CastReceiver.astro';
---
<Base
  title="Cast receiver — biohack.net"
  description="Television presentation surface for biohack.net language flashcards."
>
  <meta slot="head" name="robots" content="noindex" />
  <script
    slot="head"
    is:inline
    src="https://www.gstatic.com/cast/sdk/libs/caf_receiver/v3/cast_receiver_framework.js"
  ></script>
  <CastReceiver
    simulatorDeckUrl="/languages/th/download/th-en-foundations.tsv"
    deckLabel="THAI"
    contentLang="th"
    baseLang="en"
    deviceName="Living Room TV"
    senderName="phone"
    simulator={false}
  />
</Base>
<style is:global>
  html, body { background: #0e0e0d; height: 100%; overflow: hidden; overscroll-behavior: none; }
  body { margin: 0; max-width: none; padding: 0; }
</style>
