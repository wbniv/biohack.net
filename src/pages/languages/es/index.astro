---
import Base from '../../../layouts/Base.astro';

const samples = [
  { spanish: 'la casa', english: 'f. house, home', es: 'Nuestra casa es su casa.', en: 'Our house is your house.', grammar: 'feminine noun' },
  { spanish: 'el agua', english: 'f. water', es: 'Es una buena idea beber agua embotellada.', en: "It's a good idea to drink bottled water.", grammar: 'feminine noun' },
  { spanish: 'abrir', english: 'to open', es: '“Abra la boca,” dijo el dentista.', en: '“Open your mouth,” said the dentist.', grammar: 'verb' },
];
---
<Base title="Spanish–English flashcards — biohack.net" description="1,079 Spanish–English dictionary flashcards for Anki, plus portable TSV and printable editions.">
  <main class="page">
    <nav aria-label="Breadcrumb"><a href="/">biohack.net</a><span>/</span><a href="/languages/">languages</a><span>/</span><strong>es</strong></nav>

    <header class="hero">
      <div class="language-code" aria-hidden="true">es</div>
      <div>
        <p class="kicker">Spanish · English</p>
        <h1>A pocket dictionary<br>that remembers with you.</h1>
        <p class="lede">1,079 words with definitions and examples, built as phone-friendly Anki cards and portable source data.</p>
        <div class="hero-actions"><a class="start-review" href="/languages/es/review/">Start reviewing</a><a href="/languages/es/download/es-en-dictionary.apkg" download>Download for Anki</a></div>
      </div>
    </header>

    <section class="try" aria-labelledby="try-heading">
      <div class="section-heading">
        <div><p class="kicker">Try a card</p><h2 id="try-heading">Tap to reveal</h2></div>
        <button id="next-card" type="button">Skip →</button>
      </div>
      <button class="flashcard" id="flashcard" type="button" aria-live="polite" aria-label="Reveal answer">
        <span class="card-meta"><span class="card-label">Spanish · Recognition</span><span id="card-count">loading 1,079 words…</span></span>
        <span class="headword" id="card-spanish">{samples[0].spanish}</span>
        <span class="answer" id="card-answer" hidden>
          <span class="divider"></span>
          <span class="meaning" id="card-english">{samples[0].english}</span>
          <span class="example-es" id="card-example-es">{samples[0].es}</span>
          <span class="example-en" id="card-example-en">{samples[0].en}</span>
          <span class="grammar" id="card-grammar">{samples[0].grammar}</span>
        </span>
        <span class="tap-hint" id="tap-hint">tap to show answer</span>
      </button>
      <div class="grade-controls" id="grade-controls" hidden>
        <p>Did you remember it?</p>
        <div class="grade-buttons">
          <button class="grade again" id="grade-again" type="button"><span aria-hidden="true">👎</span><strong>Again</strong><small>repeat soon</small></button>
          <button class="grade good" id="grade-good" type="button"><span aria-hidden="true">👍</span><strong>Got it</strong><small>longer interval</small></button>
        </div>
      </div>
      <div class="review-stats" id="review-stats" aria-live="polite">
        <span><strong id="stat-due">0</strong> due</span>
        <span><strong id="stat-learning">0</strong> learning</span>
        <span><strong id="stat-seen">0</strong> seen</span>
        <span><strong id="stat-new">1,079</strong> new</span>
      </div>
    </section>

    <section class="technique" aria-labelledby="technique-heading">
      <p class="kicker">Why cards come back</p>
      <h2 id="technique-heading">A schedule built for memory</h2>
      <p class="technique-lede">Trying to recall an answer strengthens memory. Reviewing it again near the point of forgetting makes that strengthening more efficient. This reviewer combines those two documented ideas: active recall and spaced repetition.</p>
      <div class="technique-grid">
        <article><span>01</span><h3>Recall first</h3><p>Try to produce the meaning before tapping the card. Revealing without attempting recall is less useful.</p></article>
        <article><span>02</span><h3>Expand the spacing</h3><p>A remembered card moves to about one day, then three days, then progressively longer intervals with slight timing variation.</p></article>
        <article><span>03</span><h3>Relearn without drilling</h3><p>A missed card returns soon—but never immediately. At least two minutes and seven other cards separate attempts.</p></article>
      </div>
      <div class="technique-note">
        <p><strong>Your progress stays in this browser.</strong> No account is required. Anki is the better choice for cross-device sync and its full FSRS scheduler.</p>
        <button id="reset-progress" type="button">Reset browser progress</button>
      </div>
      <p class="references">Technique references: <a href="https://github.com/open-spaced-repetition/ts-fsrs" rel="noreferrer">FSRS scheduler</a> · <a href="https://www.super-memory.com/english/ol/sm2.htm" rel="noreferrer">SuperMemo SM-2</a></p>
    </section>

    <section class="downloads" aria-labelledby="download-heading">
      <p class="kicker">Choose your format</p>
      <h2 id="download-heading">Take it with you</h2>
      <div class="download-grid">
        <a class="download primary" href="/languages/es/download/es-en-dictionary.apkg" download>
          <span class="format">APKG</span><strong>Anki deck</strong><small>Best for studying on a phone</small><span class="action">Download · 163 KB</span>
        </a>
        <a class="download" href="/languages/es/download/es-en-dictionary.tsv" download>
          <span class="format">TSV</span><strong>Portable source</strong><small>UTF-8 data for Anki or another app</small><span class="action">Download · 185 KB</span>
        </a>
        <a class="download" href="/languages/es/download/es-en-dictionary-legal.pdf" download>
          <span class="format">PDF</span><strong>Compact print</strong><small>Two sides of one legal-size sheet</small><span class="action">Download · 435 KB</span>
        </a>
      </div>
    </section>

    <section class="install" aria-labelledby="install-heading">
      <p class="kicker">Phone setup</p>
      <h2 id="install-heading">Install once. Review anywhere.</h2>
      <ol>
        <li><span>1</span><div><strong>Get Anki</strong><p>Use AnkiMobile on iPhone/iPad or AnkiDroid on Android.</p></div></li>
        <li><span>2</span><div><strong>Open the APKG</strong><p>Download the deck above and open it with your Anki app.</p></div></li>
        <li><span>3</span><div><strong>Start small</strong><p>Recognition cards are active. Production cards are included but suspended until you want them.</p></div></li>
      </ol>
    </section>

    <footer><a href="/languages/">← All languages</a><span>Deck ID · biohack::languages::es-en</span></footer>
  </main>

  <script define:vars={{ samples }}>
    const STORAGE_KEY = 'biohack:languages:es-en:reviews:v1';
    const MIN_RETRY_MS = 2 * 60 * 1000;
    const MIN_INTERVENING = 7;
    const card = document.querySelector('#flashcard');
    const answer = document.querySelector('#card-answer');
    const hint = document.querySelector('#tap-hint');
    const count = document.querySelector('#card-count');
    const grades = document.querySelector('#grade-controls');
    let cards = samples.map((sample, index) => ({ ...sample, id: `sample-${index}` }));
    let current = cards[0];
    let recent = [];
    const storedReview = loadProgress();
    let reviewSerial = storedReview.serial;
    let progress = storedReview.cards;

    function loadProgress() {
      try {
        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        const storedCards = stored?.cards && typeof stored.cards === 'object' && !Array.isArray(stored.cards) ? stored.cards : {};
        const validCards = Object.fromEntries(Object.entries(storedCards).filter(([, state]) =>
          state && typeof state === 'object' && Number.isFinite(state.due) && Number.isFinite(state.reps)
        ));
        return { cards: validCards, serial: Number.isFinite(stored?.serial) ? stored.serial : 0 };
      } catch {
        return { cards: {}, serial: 0 };
      }
    }
    function saveProgress() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ serial: reviewSerial, cards: progress }));
    }
    function decode(value) {
      const textarea = document.createElement('textarea');
      textarea.innerHTML = value;
      return textarea.value;
    }
    function shuffle(values) {
      for (let index = values.length - 1; index > 0; index -= 1) {
        const swap = Math.floor(Math.random() * (index + 1));
        [values[index], values[swap]] = [values[swap], values[index]];
      }
      return values;
    }
    function stateFor(id) {
      return progress[id] || { reps: 0, lapses: 0, interval: 0, ease: 2.35, due: 0, lastReview: 0, eligibleSerial: 0 };
    }
    function isRecent(candidate) {
      return recent.includes(candidate.id);
    }
    function chooseCard({ skipCurrent = false } = {}) {
      const now = Date.now();
      const eligible = cards.filter((candidate) => !isRecent(candidate) && (!skipCurrent || candidate.id !== current?.id));
      const due = eligible.filter((candidate) => {
        const state = progress[candidate.id];
        return state && state.due <= now && (state.eligibleSerial || 0) <= reviewSerial;
      }).sort((a, b) => progress[a.id].due - progress[b.id].due);
      if (due.length) return due[0];
      const unseen = eligible.filter((candidate) => !progress[candidate.id]);
      if (unseen.length) return unseen[Math.floor(Math.random() * unseen.length)];
      const scheduled = eligible.filter((candidate) => progress[candidate.id])
        .sort((a, b) => progress[a.id].due - progress[b.id].due);
      return scheduled[0] || cards.find((candidate) => candidate.id !== current?.id) || cards[0];
    }
    function intervalLabel(state) {
      if (!state?.due) return 'new';
      const remaining = state.due - Date.now();
      if (remaining <= 0) return 'due';
      if (remaining < 60 * 60 * 1000) return `${Math.max(1, Math.round(remaining / 60000))}m`;
      return `${Math.max(1, Math.round(remaining / 86400000))}d`;
    }
    function updateStats() {
      const now = Date.now();
      const states = Object.values(progress);
      const due = states.filter((state) => state.due <= now).length;
      const learning = states.filter((state) => state.lapses > 0 && state.interval < 1).length;
      document.querySelector('#stat-due').textContent = due.toLocaleString();
      document.querySelector('#stat-learning').textContent = learning.toLocaleString();
      document.querySelector('#stat-seen').textContent = states.length.toLocaleString();
      document.querySelector('#stat-new').textContent = Math.max(0, cards.length - states.length).toLocaleString();
    }
    function showCard(next) {
      current = next;
      const state = progress[current.id];
      document.querySelector('#card-spanish').textContent = current.spanish;
      document.querySelector('#card-english').textContent = current.english;
      document.querySelector('#card-example-es').textContent = current.es;
      document.querySelector('#card-example-en').textContent = current.en;
      document.querySelector('#card-grammar').textContent = current.grammar;
      answer.hidden = true;
      hint.hidden = false;
      grades.hidden = true;
      card.setAttribute('aria-label', 'Reveal answer');
      count.textContent = `${intervalLabel(state)} · ${cards.length.toLocaleString()} cards`;
      updateStats();
    }
    card?.addEventListener('click', () => {
      answer.hidden = !answer.hidden;
      hint.hidden = !answer.hidden;
      grades.hidden = answer.hidden;
      card.setAttribute('aria-label', answer.hidden ? 'Reveal answer' : 'Hide answer');
    });
    document.querySelector('#next-card')?.addEventListener('click', () => {
      recent.push(current.id);
      recent = recent.slice(-MIN_INTERVENING);
      showCard(chooseCard({ skipCurrent: true }));
    });
    function grade(remembered) {
      const now = Date.now();
      const state = stateFor(current.id);
      reviewSerial += 1;
      if (remembered) {
        const baseInterval = state.reps === 0 ? 1 : state.reps === 1 ? 3 : Math.max(4, state.interval * state.ease);
        const fuzz = 0.95 + Math.random() * 0.1;
        state.interval = Math.max(1, Math.round(baseInterval * fuzz));
        state.reps += 1;
        state.ease = Math.min(2.7, state.ease + 0.04);
        state.due = now + state.interval * 86400000;
        state.eligibleSerial = reviewSerial;
      } else {
        state.lapses += 1;
        state.reps = Math.max(0, state.reps - 1);
        state.interval = 0;
        state.ease = Math.max(1.3, state.ease - 0.2);
        state.due = now + MIN_RETRY_MS;
        state.eligibleSerial = reviewSerial + MIN_INTERVENING;
      }
      state.lastReview = now;
      progress[current.id] = state;
      saveProgress();
      recent.push(current.id);
      recent = recent.slice(-MIN_INTERVENING);
      showCard(chooseCard({ skipCurrent: true }));
    }
    document.querySelector('#grade-again')?.addEventListener('click', () => grade(false));
    document.querySelector('#grade-good')?.addEventListener('click', () => grade(true));
    document.querySelector('#reset-progress')?.addEventListener('click', () => {
      if (!confirm('Reset all Spanish browser-review progress on this device?')) return;
      progress = {};
      reviewSerial = 0;
      recent = [];
      localStorage.removeItem(STORAGE_KEY);
      shuffle(cards);
      showCard(cards[0]);
    });
    fetch('/languages/es/download/es-en-dictionary.tsv')
      .then((response) => {
        if (!response.ok) throw new Error(`TSV request failed: ${response.status}`);
        return response.text();
      })
      .then((text) => {
        const loaded = text.split(/\r?\n/)
          .filter((line) => line && !line.startsWith('#'))
          .map((line) => line.split('\t'))
          .filter((fields) => fields.length >= 9)
          .map((fields) => ({
            id: fields[0], spanish: decode(fields[1]), english: decode(fields[2]),
            es: decode(fields[3]), en: decode(fields[4]), grammar: decode(fields[5]),
          }));
        if (loaded.length !== 1079) throw new Error(`Expected 1,079 words, loaded ${loaded.length}`);
        cards = shuffle(loaded);
        showCard(chooseCard({ skipCurrent: true }));
      })
      .catch((error) => {
        console.error(error);
        count.textContent = '3-word preview · deck has 1,079';
      });
  </script>
</Base>

<style>
