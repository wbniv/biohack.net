---
import Base from '../../../layouts/Base.astro';
const samples=[['น้ำ','water'],['แมว','cat'],['เท่าไหร่?','how much?'],['ยี่สิบเอ็ด','21']];
---
<Base title="Thai–English flashcards — biohack.net" description="110 Thai foundation flashcards with numbers, listening practice, and pronunciation guidance.">
<main class="page"><nav><a href="/">biohack.net</a> / <a href="/languages/">languages</a> / <b>th</b></nav>
<header><span class="code">th</span><div><p class="kicker">Thai · English</p><h1>See it. Hear it.<br>Shape the sound.</h1><p>110 foundation notes: numbers 0–100, 1,000 and 10,000, plus essential words and phrases.</p><div class="actions"><a href="/languages/th/review/">Start practicing</a><a class="secondary" href="/languages/th/download/th-en-foundations.tsv" download>Download TSV</a></div></div></header>
<section><p class="kicker">Try the foundation set</p><h2>Thai script from the beginning</h2><div class="samples">{samples.map(([th,en])=><article><b lang="th">{th}</b><span>{en}</span></article>)}</div></section>
<section class="method"><p class="kicker">Pronunciation coach</p><h2>Sound is more than spelling.</h2><p>Each revealed card can speak Thai and show an original mouth guide: tongue and lip position, airflow, vowel length, and tone movement. Audio uses a Thai voice available on your phone in this first release; reviewed recordings can replace it later.</p><div class="features"><article><b>👄 Mouth</b><span>See a compact articulation cue.</span></article><article><b>〽 Tone</b><span>Follow pitch movement, not English stress.</span></article><article><b>▶ Listening</b><span>Practice audio-only cards alongside recall.</span></article></div></section>
<section><p class="kicker">How cards return</p><h2>Recall, then space.</h2><p>Cards appear in shuffled order. A missed card returns after at least two minutes and seven intervening cards; remembered cards move to expanding intervals. Listening, Thai recognition, and spoken production are mixed so familiarity does not masquerade as learning.</p></section>
<footer><a href="/languages/">← All languages</a><span>Deck ID · biohack::languages::th-en</span></footer></main>
</Base>
<style>
  :global(body){background:#f2eee5;color:#211d18;max-width:none;padding:0}.page{margin:auto;max-width:900px;padding:1.5rem clamp(1.2rem,5vw,3.5rem) 5rem}nav{color:#81786d;font:700 .7rem monospace;text-transform:uppercase}nav a,footer a{color:#a74830}header{align-items:center;border-bottom:1px solid #d5cdc0;display:grid;gap:clamp(1.5rem,6vw,4rem);grid-template-columns:auto 1fr;margin:4rem 0;padding-bottom:3rem}.code{align-items:center;background:#a74830;border-radius:20px;color:white;display:flex;font:800 clamp(2rem,8vw,4rem) monospace;height:clamp(6rem,20vw,10rem);justify-content:center;width:clamp(6rem,20vw,10rem)}.kicker{color:#897f72;font:700 .68rem monospace;letter-spacing:.14em;text-transform:uppercase}h1{font-size:clamp(2.6rem,9vw,5.5rem);letter-spacing:-.055em;line-height:.95;margin:.6rem 0 1.2rem}h2{font-size:clamp(2rem,6vw,3.4rem);letter-spacing:-.04em;margin:.4rem 0 1rem}.actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.5rem}.actions a{background:#a74830;border:1px solid #a74830;border-radius:10px;color:white;font-weight:800;padding:.85rem 1.1rem;text-decoration:none}.actions .secondary{background:transparent;color:#a74830}section{border-bottom:1px solid #d5cdc0;padding:3rem 0}.samples,.features{display:grid;gap:.75rem;grid-template-columns:repeat(2,1fr)}article{background:#fffdf8;border:1px solid #d5cdc0;border-radius:14px;display:flex;flex-direction:column;padding:1.2rem}.samples b{color:#a74830;font:750 clamp(2rem,7vw,3.2rem) system-ui}.samples span,.features span,.method>p,section>p{color:#665f56;line-height:1.6}.features{grid-template-columns:repeat(3,1fr);margin-top:1.5rem}.features b{font-size:1.1rem;margin-bottom:.5rem}footer{display:flex;justify-content:space-between;padding-top:2rem;color:#81786d;font:700 .65rem monospace}@media(max-width:620px){header{align-items:start;grid-template-columns:1fr;margin-top:2.5rem}.samples,.features{grid-template-columns:1fr 1fr}.features article:last-child{grid-column:1/-1}footer{gap:1rem;flex-direction:column}}
</style>
