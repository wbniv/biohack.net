---
// /snes — gallery of in-browser SNES demos compiled with the llvm-mos-65816 toolchain.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/snes-categories';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

// The demo registry lives in the `snes` content collection (one JSON per ROM,
// which also carries each page's prose for /snes/[slug]). Gallery order = the
// entries' `order` field (the old snes-demos.ts array order). Higher values are newer, so put
// newly published ROMs first instead of making visitors hunt at the end of the gallery.
const demos = (await getCollection('snes')).map((e) => e.data).sort((a, b) => b.order - a.order);

// Cache-bust the card thumbnails: /play/* is served `immutable, max-age=1y`, and these <img> URLs
// have no ?v= (unlike the app.js-loaded ROM/engine assets), so a regenerated preview at the same
// path would stay stale in browsers for a year. Hash each PNG at build time -> ?v=<sha>.
const previewV = (slug: string) => {
  try { return createHash('sha256').update(readFileSync(`public/play/preview/${slug}.png`)).digest('hex').slice(0, 12); }
  catch { return ''; }
};

const byCategory = [
  { id: 'newest', label: 'Newest Releases', items: demos.slice(0, 8) },
  ...categories.map(cat => ({
    ...cat,
    items: demos.filter(d => d.category === cat.id),
  })).filter(c => c.items.length > 0),
];
---

<Base title="SNES Demos — bioHACK•NET" description={`${demos.length} in-browser Super Nintendo demos compiled from C with the llvm-mos-65816 toolchain — each a stress-test for the compiler's 16-bit-accumulator codegen (+mos-a16). Play them in your browser.`}>
  <main class="gl-wrap">

    <header class="gl-hero">
      <a class="gl-back" href="/">← biohack.net</a>
      <h1 class="gl-title">SNES Demos</h1>
      <p class="gl-lede">
        {demos.length} Super Nintendo programs compiled from C with an
        <a href="https://indri.studio/apps/llvm-mos-65816/">LLVM-based 65816 toolchain</a>
        — each a stress-test for the compiler's 16-bit-accumulator codegen and a runnable
        ROM verified against MAME and bsnes-jg. Click any card to play.
      </p>
    </header>

    <div class="gl-mode-filter" data-total={demos.length}>
      <button type="button" class="gl-mode-toggle" aria-pressed="false" aria-label="Show Mode 7 demos only">
        <span class="gl-mode-filter-seven" aria-hidden="true">7</span>
        <span>Mode 7</span>
        <span class="gl-mode-check" aria-hidden="true">✓</span>
      </button>
      <span class="gl-mode-count" aria-live="polite">{demos.length} demos</span>
    </div>

    {byCategory.map(({ id, label, items }) => (
      <section class="cat-shelf" id={`cat-${id}`}>
        <div class="cat-header">
          <h2 class="cat-title">{label}</h2>
          <div class="cat-nav">
            <button class="cat-btn cat-prev" aria-label={`Scroll ${label} left`}>‹</button>
            <button class="cat-btn cat-next" aria-label={`Scroll ${label} right`}>›</button>
          </div>
        </div>
        <ul class="cat-row" role="list">
          {items.map(({ slug, title, keys, displayMode }) => {
            const v = previewV(slug);
            return (
              <li class="cat-card" data-display-mode={displayMode}>
                <a href={`/snes/${slug}/`} class="cat-card-link" aria-label={`Play ${title}`}>
                  <div class="cat-thumb-wrap">
                    <img
                      class="cat-thumb"
                      src={`/play/preview/${slug}.png${v ? `?v=${v}` : ''}`}
                      alt={`${title} preview`}
                      width="256"
                      height="224"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="cat-play-overlay" aria-hidden="true">▶</div>
                    {displayMode === 7 && (
                      <span class="gl-mode7-badge" title="Mode 7 display" aria-label="Mode 7 display">7</span>
                    )}
                  </div>
                  <div class="cat-card-body">
                    <h3 class="cat-card-title">{title}</h3>
                    <p class="cat-card-keys">{keys}</p>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}

    <p class="gl-foot">
      Each ROM boots in the bsnes-jg WASM core — no install, no plugin. Hit
      <b>Verify fidelity</b> on any demo page to replay the CI gate live in the browser.
    </p>

  </main>
</Base>

<script is:inline>
  var shelves = Array.from(document.querySelectorAll('.cat-shelf'));
  shelves.forEach(function(shelf) {
    var row = shelf.querySelector('.cat-row');
    function scrollAmt() { return Math.floor(row.clientWidth * 0.85); }
    var prev = shelf.querySelector('.cat-prev');
    var next = shelf.querySelector('.cat-next');
    if (prev) prev.addEventListener('click', function() { row.scrollBy({ left: -scrollAmt(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function() { row.scrollBy({ left:  scrollAmt(), behavior: 'smooth' }); });
  });
  var modeWrap = document.querySelector('.gl-mode-filter');
  var modeToggle = document.querySelector('.gl-mode-toggle');
  var modeCount = document.querySelector('.gl-mode-count');
  var mode7 = false;
  function updateShelfNav(shelf) {
    var row = shelf.querySelector('.cat-row');
    var nav = shelf.querySelector('.cat-nav');
    if (nav) nav.hidden = row.scrollWidth <= row.clientWidth + 1;
  }
  function applyMode7() {
    var shown = 0;
    document.querySelectorAll('.cat-card').forEach(function(card) {
      var visible = !mode7 || card.dataset.displayMode === '7';
      card.hidden = !visible;
      if (visible) shown++;
    });
    shelves.forEach(function(shelf) {
      var visible = !!shelf.querySelector('.cat-card:not([hidden])');
      shelf.hidden = !visible;
      if (visible && mode7) shelf.querySelector('.cat-row').scrollLeft = 0;
      if (visible) requestAnimationFrame(function() { updateShelfNav(shelf); });
    });
    modeToggle.setAttribute('aria-pressed', String(mode7));
    modeToggle.setAttribute('aria-label', mode7 ? 'Show all demos' : 'Show Mode 7 demos only');
    modeCount.textContent = mode7 ? shown + ' Mode 7 demos' : modeWrap.dataset.total + ' demos';
    var url = new URL(location.href);
    if (mode7) url.searchParams.set('mode', '7'); else url.searchParams.delete('mode');
    history.replaceState(null, '', url);
  }
  modeToggle.addEventListener('click', function() { mode7 = !mode7; applyMode7(); });
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape' && mode7 && document.querySelector('.gl-wrap:focus-within')) {
      mode7 = false; applyMode7(); modeToggle.focus();
    }
  });
  window.addEventListener('popstate', function() {
    mode7 = new URL(location.href).searchParams.get('mode') === '7'; applyMode7();
  });
  mode7 = new URL(location.href).searchParams.get('mode') === '7';
  applyMode7();
</script>

<style>
  .gl-wrap {
    max-width: 960px;
    margin-inline: auto;
    padding: 2.5rem 1.25rem 5rem;
  }

  /* ── back link ──────────────────────────────────────── */
  .gl-back {
    display: inline-block;
    font-size: 12px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 0.15s;
  }
  .gl-back:hover { color: var(--accent); }

  /* ── hero ───────────────────────────────────────────── */
  .gl-hero { max-width: 42rem; margin-bottom: 2.75rem; }
  .gl-title {
    font-family: 'Dune Rise', 'Space Grotesk', system-ui, sans-serif;
    font-weight: 400;
    font-size: clamp(2rem, 9vw, 3.2rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--ink);
    margin: 0 0 1rem;
  }
  .gl-lede {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink);
    opacity: 0.85;
    margin: 0;
  }
  .gl-lede a { color: var(--accent); text-decoration: none; }
  .gl-lede a:hover { text-decoration: underline; }
  .gl-mode-filter {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: -1.5rem 0 2rem;
  }
  .gl-mode-toggle {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 7px;
    background: transparent;
    color: var(--ink-dim);
    font: 700 12px 'JetBrains Mono', ui-monospace, monospace;
    cursor: pointer;
  }
  .gl-mode-toggle[aria-pressed="true"] {
    color: #74ffe5;
    border-color: #74ffe5;
    background: rgba(10, 51, 48, 0.72);
    box-shadow: inset 3px 0 #74ffe5;
  }
  .gl-mode-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .gl-mode-filter-seven {
    display: grid; width: 25px; height: 25px; place-items: center;
    border: 1px solid #74ffe5; border-radius: 5px; background: #051321; color: #74ffe5;
    font-size: 14px;
  }
  .gl-mode-check { visibility: hidden; }
  .gl-mode-toggle[aria-pressed="true"] .gl-mode-check { visibility: visible; }
  .gl-mode-count { color: var(--ink-dim); font: 11px 'JetBrains Mono', ui-monospace, monospace; }

  /* ── category shelf ─────────────────────────────────── */
  .cat-shelf { margin-bottom: 2.75rem; }

  .cat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .cat-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin: 0;
  }
  .cat-nav { display: flex; gap: 0.35rem; }
  .cat-btn {
    background: transparent;
    color: var(--ink-dim);
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    border: 1px solid var(--accent-soft, rgba(194,65,12,0.35));
    border-radius: 6px;
    padding: 0.2rem 0.55rem;
    transition: border-color 0.15s, color 0.15s;
  }
  .cat-btn:hover { border-color: var(--accent); color: var(--accent); }

  /* ── scrollable row ─────────────────────────────────── */
  .cat-row {
    display: flex;
    gap: 10px;
    list-style: none;
    padding: 0 0 6px;
    margin: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .cat-row::-webkit-scrollbar { display: none; }

  /* ── card ───────────────────────────────────────────── */
  .cat-card {
    flex: 0 0 180px;
    scroll-snap-align: start;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .cat-card:hover {
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(194, 65, 12, 0.3), 0 0 40px rgba(194, 65, 12, 0.1);
  }
  .cat-card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  /* ── thumbnail ──────────────────────────────────────── */
  .cat-thumb-wrap {
    position: relative;
    background: #000;
    line-height: 0;
    overflow: hidden;
  }
  .cat-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 256 / 224;
    image-rendering: pixelated;
    object-fit: cover;
    transition: opacity 0.2s;
  }
  .cat-card:hover .cat-thumb { opacity: 0.82; }
  .cat-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 0 20px rgba(194, 65, 12, 0.9), 0 0 4px rgba(0,0,0,0.8);
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .cat-card:hover .cat-play-overlay { opacity: 1; }
  .gl-mode7-badge {
    position: absolute;
    z-index: 2;
    top: 7px;
    left: 7px;
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 1px solid rgba(116, 255, 229, 0.9);
    border-radius: 5px;
    background: rgba(5, 19, 33, 0.88);
    color: #74ffe5;
    font: 700 14px/1 'JetBrains Mono', ui-monospace, monospace;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  /* ── card body ──────────────────────────────────────── */
  .cat-card-body {
    padding: 0.6rem 0.75rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .cat-card-title {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    transition: color 0.15s;
  }
  .cat-card:hover .cat-card-title { color: var(--accent); }
  .cat-card-keys {
    margin: 0;
    font-size: 10px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    color: var(--ink-dim);
    opacity: 0.6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    align-self: flex-end;
  }

  @media (max-width: 520px) {
    .cat-card { flex: 0 0 140px; }
    .cat-card-title { font-size: 11px; }
    .gl-mode7-badge { width: 22px; height: 22px; font-size: 13px; }
  }

  /* ── footer note ────────────────────────────────────── */
  .gl-foot {
    margin-top: 2.25rem;
    font-size: 13px;
    color: var(--ink-dim);
    line-height: 1.65;
    max-width: 42rem;
  }
  .gl-foot b { color: var(--ink); }
</style>
