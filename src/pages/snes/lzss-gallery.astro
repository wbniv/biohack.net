---
import Base from '../../layouts/Base.astro';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import catalog from '../../data/lzss-gallery-catalog.json';
const PLAY = 'public/play';
const files = ['app.js','cores/bsnes_jg.js','cores/bsnes_jg.wasm','roms/manifest.json',
  'roms/lzss-gallery.sfc','preview/lzss-gallery.png'];
const bust: Record<string,string> = {};
for (const f of files) try { bust[f]=createHash('sha256').update(readFileSync(`${PLAY}/${f}`)).digest('hex').slice(0,12); } catch {}
const appV=bust['app.js']??'';
