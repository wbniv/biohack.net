const works = catalog;
---
<Base title="LZSS Mode 7 Gallery — bioHACK•NET" description="An on-SNES LZSS compressor/decompressor benchmark using 60 public-domain artworks as its visible Mode 7 corpus.">
  <main class="rp-wrap">
    <header class="rp-hero"><h1 class="rp-title">LZSS Mode 7 Gallery</h1>
      <a href="/snes/#cat-algorithms" class="rp-cat-chip">Algorithms &amp; Data</a>
      <p class="rp-lede">A complete LZSS compressor and decompressor benchmark running on the 3.58 MHz
      65816. Sixty artworks form a 930,035-byte corpus: each is decoded, displayed through Mode 7,
      recompressed on the SNES, compared byte-for-byte with the host golden stream, decoded again,
      checksummed, and verified.</p></header>
    <section id="bjg-embed" class="rp-player" aria-label="Live SNES LZSS gallery">
      <div class="rp-screen"><canvas id="screen" width="256" height="224"></canvas></div>
      <div class="rp-row"><span id="status" class="rp-status">loading core…</span><span id="checkresult" class="rp-badge"></span>
      <button id="verify" class="rp-btn" disabled>Verify benchmark</button><button id="fullscreen" class="rp-btn">Fullscreen</button></div>
      <p class="rp-keys">Left/Right: previous/next work · the meter advances by bytes processed; D/C/V are measured frames.</p>
      <p class="rp-keys"><b>Pointer:</b> tap or click the visible Previous/Next chevron to move between works.</p>
      <p id="banner" class="rp-banner"></p>
    </section>
    <section class="rp-doc"><h2>The benchmark</h2>
      <p>The aspect-preserving, up-to-219-color corpus compresses from <b>930,035</b> to <b>884,107 bytes</b>,
      a weighted <b>4.94%</b> reduction—high-color dither is a deliberately difficult LZSS input.
      Every work is rendered at its largest tile-budget fit.
      Left/Right navigation cancels the current stage immediately and starts the selected work
      without contaminating its benchmark sample. The final WRAM oracle is <code>0x1D8E</code>.</p>
      <h2>Current candidate corpus</h2><p>All {works.length} current candidates are shown below using
      the actual indexed image prepared for the SNES. Every title links to its canonical museum or
      collection record. The cartridge is being curated back to 8 Mbit (1 MiB), so this visual list
      is intentionally published before the next ROM.</p>
      <div class="rp-gallery">
        {works.map((work)=><article class="rp-work">
          <a href={work.object_url}><img src={work.preview} alt={`${work.title} by ${work.artist}`} loading="lazy" /></a>
          <h3><a href={work.object_url}>{work.title}</a></h3>
          <p>{work.artist}<br /><span>{work.date}</span></p>
        </article>)}
      </div>
      <p class="rp-foot">8 Mbit (1 MiB) LoROM · +mos-a16 · Mode 7 artwork / HDMA Mode 1 caption split ·
      deterministic 4 KiB-window LZSS · exact target/host stream equality.</p>
    </section>
  </main>
</Base>
<script is:inline define:vars={{bust,appV}}>
  function bootEmulator() {
    if (!document.getElementById('bjg-embed')) return;
    if (window.__bjgStop) { try { window.__bjgStop(); } catch (e) {} }
    window.BJG_BASE = '/play/';
    window.BJG_DEFAULT_ROM = 'lzss-gallery';
    window.BJG_BUST = bust;
    window.BsnesJg = undefined;
    window.__bjg = undefined;
    var old = document.getElementById('bjg-appjs');
    if (old) old.remove();
    var s = document.createElement('script');
    s.id = 'bjg-appjs';
    s.src = '/play/app.js' + (appV ? '?v=' + appV : '');
    document.body.appendChild(s);
  }
  if (!window.__bjgReg) {
    window.__bjgReg = true;
    document.addEventListener('astro:page-load', bootEmulator);
  }
  if (document.readyState !== 'loading') bootEmulator();
  else document.addEventListener('DOMContentLoaded', bootEmulator);
</script>

<style>
  .rp-cat-chip {
    display: inline-block; margin-top: .5rem; padding: 3px 10px;
    font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    color: var(--ink-dim); background: var(--bg-soft, #1e2128);
    border: 1px solid var(--rule, #2e3138); border-radius: 4px;
    text-decoration: none; transition: border-color .15s, color .15s;
  }
  .rp-cat-chip:hover { border-color: var(--accent); color: var(--accent); }
  .rp-wrap { --rp-accent: var(--accent); max-width: 900px; margin-inline: auto; padding: 2.5rem 1.25rem 4rem; }
  .rp-hero { max-width: 42rem; margin-inline: auto; text-align: center; }
  .rp-title {
    font-family: 'Dune Rise', 'Space Grotesk', system-ui, sans-serif; font-weight: 400;
    text-transform: uppercase; letter-spacing: .04em; line-height: 1;
    font-size: clamp(2.2rem, 9vw, 3.5rem); margin: 0; color: var(--ink);
  }
  .rp-lede { margin: 1rem 0 0; color: var(--ink); opacity: .85; line-height: 1.65; }
  .rp-lede code, .rp-lede a {
    font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--accent);
  }
  .rp-lede a:hover { text-decoration: underline; }

  .rp-player { max-width: 544px; margin: 2.25rem auto 0; }
  .rp-screen {
    width: 100%; background: #000; border-radius: 6px; line-height: 0;
    border: 1px solid var(--rule);
  }
  .rp-screen canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .rp-row {
    display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; margin-top: .85rem;
    font: 12px/1.4 'JetBrains Mono', ui-monospace, monospace; color: var(--ink-dim);
  }
  .rp-btn {
    margin-left: auto; background: transparent; color: var(--ink-dim); cursor: pointer;
    font-size: 12px; font-family: 'JetBrains Mono', ui-monospace, monospace;
    border: 1px solid var(--accent-soft); border-radius: 6px; padding: .4rem .85rem;
    transition: border-color .15s, color .15s;
  }
  .rp-btn + .rp-btn { margin-left: 0; }
  .rp-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .rp-btn:disabled { opacity: .45; cursor: not-allowed; }
  .rp-badge { font: 12px 'JetBrains Mono', ui-monospace, monospace; }
  .rp-badge.running { color: var(--accent); }
  .rp-badge.pass {
    background: #54d98c; color: #0c1116; font-weight: 600;
    padding: 2px 8px; border-radius: 5px;
  }
  .rp-badge.fail {
    background: #ff6b6b; color: #0c1116; font-weight: 600;
    padding: 2px 8px; border-radius: 5px;
  }
  .rp-keys { margin: .75rem 0 0; font-size: 11.5px; color: var(--ink-dim); font-style: italic; }
  .rp-banner { margin: .6rem 0 0; font-size: 12px; color: var(--ink-dim); }
  .rp-banner :global(b) { color: var(--ink); }
  .rp-banner :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--accent);
  }

  .rp-doc { max-width: 42rem; margin: 3rem auto 0; color: var(--ink); line-height: 1.7; }
  .rp-doc h2 {
    font-size: 12px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: #7dd3fc; margin: 2.25rem 0 .6rem;
  }
  .rp-doc p { margin: .4rem 0; }
  .rp-doc b { color: var(--ink); }
  .rp-doc code {
    font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--accent);
  }
  .rp-doc a { color: var(--accent); text-decoration: none; }
  .rp-doc a:hover { text-decoration: underline; }
  .rp-table { width: 100%; border-collapse: collapse; margin: .5rem 0 1rem; }
  .rp-table th {
    text-align: left; text-transform: uppercase; font-size: .68rem; letter-spacing: .08em;
    color: var(--ink-dim); padding: .35rem .6rem; border-bottom: 1px solid var(--rule);
  }
  .rp-table td { padding: .35rem .6rem; border-bottom: 1px solid var(--rule); }
  .rp-gallery {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem; margin: 1rem 0 2rem;
  }
  .rp-work {
    min-width: 0; overflow: hidden; border: 1px solid var(--rule); border-radius: 6px;
    background: var(--bg-soft, #151820);
  }
  .rp-work > a {
    display: grid; place-items: center; height: 168px; background: #000;
  }
  .rp-work img { display: block; width: 100%; height: 100%; object-fit: contain; image-rendering: pixelated; }
  .rp-work h3 {
    margin: .75rem .8rem .2rem; font-size: .9rem; line-height: 1.35; font-weight: 600;
  }
  .rp-work p { margin: 0 .8rem .85rem; color: var(--ink-dim); font-size: .78rem; line-height: 1.45; }
  .rp-work span { opacity: .75; }
  .rp-foot { margin-top: 1.5rem; font-size: 13px; color: var(--ink-dim); }
</style>
