---
import Base from '../../layouts/Base.astro';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
const PLAY = 'public/play';
const files = ['app.js','cores/bsnes_jg.js','cores/bsnes_jg.wasm','roms/manifest.json',
  'roms/lzss-gallery.sfc','preview/lzss-gallery.png'];
const bust: Record<string,string> = {};
for (const f of files) try { bust[f]=createHash('sha256').update(readFileSync(`${PLAY}/${f}`)).digest('hex').slice(0,12); } catch {}
const appV=bust['app.js']??'';
const works = [
  ['Katsushika Hokusai','Under the Wave off Kanagawa'],['Vincent van Gogh','The Bedroom'],
  ['Georges Seurat','A Sunday on La Grande Jatte — 1884'],['Pierre-Auguste Renoir','Two Sisters (On the Terrace)'],
  ['Claude Monet','Water Lilies'],['Paul Cézanne','The Basket of Apples'],['Claude Monet','Stack of Wheat'],
  ['Vincent van Gogh','Self-Portrait'],['Gustave Caillebotte','Paris Street; Rainy Day'],['Claude Monet','Poppy Field (Giverny)']
];
---
<Base title="LZSS Mode 7 Gallery — bioHACK•NET" description="An on-SNES LZSS compressor/decompressor benchmark using ten public-domain artworks as its visible Mode 7 corpus.">
  <main class="rp-wrap">
    <header class="rp-hero"><h1 class="rp-title">LZSS Mode 7 Gallery</h1>
      <a href="/snes/#cat-algorithms" class="rp-cat-chip">Algorithms &amp; Data</a>
      <p class="rp-lede">A complete LZSS compressor and decompressor benchmark running on the 3.58 MHz
      65816. Ten artworks form a 154,840-byte corpus: each is decoded, displayed through Mode 7,
      recompressed on the SNES, compared byte-for-byte with the host golden stream, decoded again,
      checksummed, and verified.</p></header>
    <section id="bjg-embed" class="rp-player" aria-label="Live SNES LZSS gallery">
      <div class="rp-screen"><canvas id="screen" width="256" height="224"></canvas></div>
      <div class="rp-row"><span id="status" class="rp-status">loading core…</span><span id="checkresult" class="rp-badge"></span>
      <button id="verify" class="rp-btn" disabled>Verify benchmark</button><button id="fullscreen" class="rp-btn">Fullscreen</button></div>
      <p class="rp-keys">Left/Right: previous/next work · the meter advances by bytes processed; D/C/V are measured frames.</p>
      <p id="banner" class="rp-banner"></p>
    </section>
    <section class="rp-doc"><h2>The benchmark</h2>
      <p>The aspect-preserving 219-color corpus compresses from <b>154,840</b> to <b>154,761 bytes</b>,
      a weighted <b>0.05%</b> reduction—high-color dither is a deliberately difficult LZSS input.
      Every work is rendered at its largest tile-budget fit.
      Left/Right navigation cancels the current stage immediately and starts the selected work
      without contaminating its benchmark sample. The final WRAM oracle is <code>0xBFAB</code>.</p>
      <h2>Public-domain corpus</h2><p>All images carry the Art Institute of Chicago's CC0 Public
      Domain Designation. Credits are retained even though CC0 does not require attribution.</p>
      <table class="rp-table"><thead><tr><th>Artist</th><th>Work</th></tr></thead>
      <tbody>{works.map(([a,w])=><tr><td>{a}</td><td>{w}</td></tr>)}</tbody></table>
      <p class="rp-foot">512 KiB LoROM · +mos-a16 · Mode 7 artwork / HDMA Mode 1 caption split ·
      deterministic 4 KiB-window LZSS · exact target/host stream equality.</p>
    </section>
  </main>
</Base>
<script is:inline define:vars={{bust,appV}}>
function boot(){window.BJG_BASE='/play/';window.BJG_DEFAULT_ROM='lzss-gallery';window.BJG_BUST=bust;
var s=document.createElement('script');s.id='bjg-appjs';s.src='/play/app.js'+(appV?'?v='+appV:'');document.body.appendChild(s)}
if(document.readyState!=='loading')boot();else document.addEventListener('DOMContentLoaded',boot);
</script>
