---
import Base from '../../layouts/Base.astro';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
const PLAY = 'public/play';
const files = ['app.js','cores/bsnes_jg.js','cores/bsnes_jg.wasm','roms/manifest.json',
  'roms/lzss-gallery.sfc','preview/lzss-gallery.png'];
const bust: Record<string,string> = {};
for (const f of files) try { bust[f]=createHash('sha256').update(readFileSync(`${PLAY}/${f}`)).digest('hex').slice(0,12); } catch {}
const appV=bust['app.js']??'';
const works = [
  ['Katsushika Hokusai','Under the Wave off Kanagawa','https://www.artic.edu/artworks/24645'],
  ['Vincent van Gogh','The Bedroom','https://www.artic.edu/artworks/28560'],
  ['Georges Seurat','A Sunday on La Grande Jatte — 1884','https://www.artic.edu/artworks/27992'],
  ['Pierre-Auguste Renoir','Two Sisters (On the Terrace)','https://www.artic.edu/artworks/14655'],
  ['Claude Monet','Water Lilies','https://www.artic.edu/artworks/16568'],
  ['Paul Cézanne','The Basket of Apples','https://www.artic.edu/artworks/111436'],
  ['Claude Monet','Stack of Wheat','https://www.artic.edu/artworks/111318'],
  ['Vincent van Gogh','Self-Portrait','https://www.artic.edu/artworks/80607'],
  ['Gustave Caillebotte','Paris Street; Rainy Day','https://www.artic.edu/artworks/20684'],
  ['Claude Monet','Poppy Field (Giverny)','https://www.artic.edu/artworks/4783'],
  ['Hieronymus Bosch','The Garden of Earthly Delights','https://www.museodelprado.es/en/the-collection/art-work/the-garden-of-earthly-delights-triptych/02388242-6d6a-4e9e-a992-e1311eab3609'],
  ['Edvard Munch','The Scream','https://www.nasjonalmuseet.no/en/collection/object/NG.M.00939'],
  ['Francisco de Goya','The Third of May 1808','https://www.museodelprado.es/en/the-collection/art-work/the-3rd-of-may-1808-in-madrid-or-the-executions/5e177409-2993-4240-97fb-847a02c6496c'],
  ['Gustav Klimt','The Kiss (Lovers)','https://www.belvedere.at/en/kiss-gustav-klimt'],
  ['Johannes Vermeer','View of Delft','https://www.mauritshuis.nl/en/our-collection/artworks/92-view-of-delft'],
  ['Jacob van Ruisdael','The Windmill at Wijk bij Duurstede','https://www.rijksmuseum.nl/en/collection/SK-C-211'],
  ['Ambrosius Bosschaert the Elder','Flower Still Life','https://www.getty.edu/art/collection/object/103REY'],
  ['Vincent van Gogh','Sunflowers','https://www.nationalgallery.org.uk/paintings/vincent-van-gogh-sunflowers'],
  ['Piet Mondriaan','Tableau No. VII','https://commons.wikimedia.org/wiki/File:Piet_Mondrian_Tableau_N_VII.jpg'],
  ['Hendrick Avercamp','Winter Landscape with Ice Skaters','https://www.rijksmuseum.nl/en/collection/SK-A-1718'],
  ['George Inness','The Home of the Heron','https://www.artic.edu/artworks/64724/the-home-of-the-heron'],
  ['Artist unknown','Dragon','https://www.artic.edu/artworks/140610/dragon'],
  ['After Gao Kegong','Scholar in Landscape','https://www.artic.edu/artworks/12314/scholar-in-landscape'],
  ['Claude Monet','Houses of Parliament, London','https://www.artic.edu/artworks/16584/houses-of-parliament-london'],
  ['John Singer Sargent','Thistles','https://www.artic.edu/artworks/145807/thistles'],
  ['Vincent van Gogh','The Starry Night','https://www.moma.org/collection/works/79802'],
  ['Aert van der Neer','River View by Moonlight','https://id.rijksmuseum.nl/200107781'],
  ['Jacob van Ruisdael','Mountainous Landscape with Waterfall','https://id.rijksmuseum.nl/200108484'],
  ['Meindert Hobbema','Wooded Landscape with Merrymakers in a Cart','https://id.rijksmuseum.nl/200445746'],
  ['Jan van Goyen','Panoramic View of a Wide River','https://id.rijksmuseum.nl/200109337'],
  ['Salomon van Ruysdael','Sailing Vessels on an Inland Body of Water','https://id.rijksmuseum.nl/20026241'],
  ['Willem van de Velde','Ships near the Coast during a Calm','https://id.rijksmuseum.nl/20026835'],
  ['Pieter de Hooch','Interior with Women beside a Linen Cupboard','https://id.rijksmuseum.nl/2003051'],
  ['Pieter Saenredam','Interior of the Sint-Odulphuskerk in Assendelft','https://id.rijksmuseum.nl/200107965'],
  ['Rachel Ruysch','Still Life with Flowers on a Marble Tabletop','https://id.rijksmuseum.nl/20027537'],
  ['Jan Davidsz. de Heem','Still Life with Flowers in a Glass Vase','https://id.rijksmuseum.nl/20029045']
];
---
<Base title="LZSS Mode 7 Gallery — bioHACK•NET" description="An on-SNES LZSS compressor/decompressor benchmark using 36 public-domain artworks as its visible Mode 7 corpus.">
  <main class="rp-wrap">
    <header class="rp-hero"><h1 class="rp-title">LZSS Mode 7 Gallery</h1>
      <a href="/snes/#cat-algorithms" class="rp-cat-chip">Algorithms &amp; Data</a>
      <p class="rp-lede">A complete LZSS compressor and decompressor benchmark running on the 3.58 MHz
      65816. Thirty-six artworks form a 558,432-byte corpus: each is decoded, displayed through Mode 7,
      recompressed on the SNES, compared byte-for-byte with the host golden stream, decoded again,
      checksummed, and verified.</p></header>
    <section id="bjg-embed" class="rp-player" aria-label="Live SNES LZSS gallery">
      <div class="rp-screen"><canvas id="screen" width="256" height="224"></canvas></div>
      <div class="rp-row"><span id="status" class="rp-status">loading core…</span><span id="checkresult" class="rp-badge"></span>
      <button id="verify" class="rp-btn" disabled>Verify benchmark</button><button id="fullscreen" class="rp-btn">Fullscreen</button></div>
      <p class="rp-keys">Left/Right: previous/next work · the meter advances by bytes processed; D/C/V are measured frames.</p>
      <p class="rp-keys"><b>Pointer:</b> tap or click the visible Previous/Next chevron to move between works.</p>
      <p id="banner" class="rp-banner"></p>
    </section>
    <section class="rp-doc"><h2>The benchmark</h2>
      <p>The aspect-preserving, up-to-219-color corpus compresses from <b>558,432</b> to <b>544,951 bytes</b>,
      a weighted <b>2.41%</b> reduction—high-color dither is a deliberately difficult LZSS input.
      Every work is rendered at its largest tile-budget fit.
      Left/Right navigation cancels the current stage immediately and starts the selected work
      without contaminating its benchmark sample. The final WRAM oracle is <code>0xBA3A</code>.</p>
      <h2>Public-domain corpus</h2><p>The original ten Art Institute of Chicago images are CC0.
      Each added museum scan is explicitly marked public domain; every title links to its canonical
      museum or collection record.</p>
      <table class="rp-table"><thead><tr><th>Artist</th><th>Work</th></tr></thead>
      <tbody>{works.map(([a,w,url])=><tr><td>{url ? <a href={url}>{a}</a> : a}</td><td>{url ? <a href={url}>{w}</a> : w}</td></tr>)}</tbody></table>
      <img class="rp-contact" src="/play/preview/lzss-gallery-contact-sheet.png" alt="Contact sheet of all 36 Mode 7 gallery artworks" loading="lazy" />
      <p class="rp-foot">8 Mbit (1 MiB) LoROM · +mos-a16 · Mode 7 artwork / HDMA Mode 1 caption split ·
      deterministic 4 KiB-window LZSS · exact target/host stream equality.</p>
    </section>
  </main>
</Base>
<script is:inline define:vars={{bust,appV}}>
  function bootEmulator() {
    if (!document.getElementById('bjg-embed')) return;
    if (window.__bjgStop) { try { window.__bjgStop(); } catch (e) {} }
    window.BJG_BASE = '/play/';
    window.BJG_DEFAULT_ROM = 'lzss-gallery';
    window.BJG_BUST = bust;
    window.BsnesJg = undefined;
    window.__bjg = undefined;
    var old = document.getElementById('bjg-appjs');
    if (old) old.remove();
    var s = document.createElement('script');
    s.id = 'bjg-appjs';
    s.src = '/play/app.js' + (appV ? '?v=' + appV : '');
    document.body.appendChild(s);
  }
  if (!window.__bjgReg) {
    window.__bjgReg = true;
    document.addEventListener('astro:page-load', bootEmulator);
  }
  if (document.readyState !== 'loading') bootEmulator();
  else document.addEventListener('DOMContentLoaded', bootEmulator);
</script>

<style>
  .rp-cat-chip {
    display: inline-block; margin-top: .5rem; padding: 3px 10px;
    font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    color: var(--ink-dim); background: var(--bg-soft, #1e2128);
    border: 1px solid var(--rule, #2e3138); border-radius: 4px;
    text-decoration: none; transition: border-color .15s, color .15s;
  }
  .rp-cat-chip:hover { border-color: var(--accent); color: var(--accent); }
  .rp-wrap { --rp-accent: var(--accent); max-width: 900px; margin-inline: auto; padding: 2.5rem 1.25rem 4rem; }
  .rp-hero { max-width: 42rem; margin-inline: auto; text-align: center; }
  .rp-title {
    font-family: 'Dune Rise', 'Space Grotesk', system-ui, sans-serif; font-weight: 400;
    text-transform: uppercase; letter-spacing: .04em; line-height: 1;
    font-size: clamp(2.2rem, 9vw, 3.5rem); margin: 0; color: var(--ink);
  }
  .rp-lede { margin: 1rem 0 0; color: var(--ink); opacity: .85; line-height: 1.65; }
  .rp-lede code, .rp-lede a {
    font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--accent);
  }
  .rp-lede a:hover { text-decoration: underline; }

  .rp-player { max-width: 544px; margin: 2.25rem auto 0; }
  .rp-screen {
    width: 100%; background: #000; border-radius: 6px; line-height: 0;
    border: 1px solid var(--rule);
  }
  .rp-screen canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .rp-row {
    display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; margin-top: .85rem;
    font: 12px/1.4 'JetBrains Mono', ui-monospace, monospace; color: var(--ink-dim);
  }
  .rp-btn {
    margin-left: auto; background: transparent; color: var(--ink-dim); cursor: pointer;
    font-size: 12px; font-family: 'JetBrains Mono', ui-monospace, monospace;
    border: 1px solid var(--accent-soft); border-radius: 6px; padding: .4rem .85rem;
    transition: border-color .15s, color .15s;
  }
  .rp-btn + .rp-btn { margin-left: 0; }
  .rp-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .rp-btn:disabled { opacity: .45; cursor: not-allowed; }
  .rp-badge { font: 12px 'JetBrains Mono', ui-monospace, monospace; }
  .rp-badge.running { color: var(--accent); }
  .rp-badge.pass {
    background: #54d98c; color: #0c1116; font-weight: 600;
    padding: 2px 8px; border-radius: 5px;
  }
  .rp-badge.fail {
    background: #ff6b6b; color: #0c1116; font-weight: 600;
    padding: 2px 8px; border-radius: 5px;
  }
  .rp-keys { margin: .75rem 0 0; font-size: 11.5px; color: var(--ink-dim); font-style: italic; }
  .rp-banner { margin: .6rem 0 0; font-size: 12px; color: var(--ink-dim); }
  .rp-banner :global(b) { color: var(--ink); }
  .rp-banner :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--accent);
  }

  .rp-doc { max-width: 42rem; margin: 3rem auto 0; color: var(--ink); line-height: 1.7; }
  .rp-doc h2 {
    font-size: 12px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: #7dd3fc; margin: 2.25rem 0 .6rem;
  }
  .rp-doc p { margin: .4rem 0; }
  .rp-doc b { color: var(--ink); }
  .rp-doc code {
    font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--accent);
  }
  .rp-doc a { color: var(--accent); text-decoration: none; }
  .rp-doc a:hover { text-decoration: underline; }
  .rp-table { width: 100%; border-collapse: collapse; margin: .5rem 0 1rem; }
  .rp-table th {
    text-align: left; text-transform: uppercase; font-size: .68rem; letter-spacing: .08em;
    color: var(--ink-dim); padding: .35rem .6rem; border-bottom: 1px solid var(--rule);
  }
  .rp-table td { padding: .35rem .6rem; border-bottom: 1px solid var(--rule); }
  .rp-contact {
    display: block; width: min(100%, 512px); height: auto; margin: 1.5rem auto;
    border: 1px solid var(--rule); border-radius: 6px; background: #000;
  }
  .rp-foot { margin-top: 1.5rem; font-size: 13px; color: var(--ink-dim); }
</style>
