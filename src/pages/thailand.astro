---
import source from '../content/thailand/page.html?raw';

const head = source.match(/<head>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const body = source.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
---
<!doctype html>
<html lang="en">
  <head><Fragment set:html={head} /></head>
  <body><Fragment set:html={body} /></body>
</html>
