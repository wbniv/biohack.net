---
import Base from '../layouts/Base.astro';
import { phases, tasks, events, categories } from '../data/thailand-plan.mjs';
const eventTasks = Object.fromEntries(events.map(e => [e.id, tasks.filter(t => t.events.includes(e.id)).map(t => t.id)]));
const nav = [['outcome','Outcome'],['decision','Decision'],['calendar','Calendar'],...phases.map(p=>[p.id,p.label])];
---
<Base title="Return to Thailand — January 2027 master plan" description="Interactive plan for returning to Bangkok with the cat on durable lawful status.">
  <main class="plan-shell">
    <header class="hero" id="outcome">
      <p class="eyebrow">THE ROAD BACK TO BANGKOK</p>
      <h1>Return to Thailand</h1>
      <p class="lede">Be back in Bangkok with the cat around January 2027, on durable lawful status, while genuinely learning Thai—without an unnecessary Pacific round-trip.</p>
      <dl class="status-row" aria-label="Plan parameters"><div><dt>Target</dt><dd>Jan 2027</dd></div><div><dt>Route</dt><dd>Asia only</dd></div><div><dt>Thai study</dt><dd>Every visa route</dd></div></dl>
    </header>

    <section class="progress-card" aria-labelledby="progress-title">
      <div><p class="eyebrow" id="progress-title">LOCAL PROGRESS</p><strong><span id="complete-count">0</span> of {tasks.length} completed</strong></div>
      <div class="progress-track global-progress" role="progressbar" aria-label="Plan completion" aria-valuemin="0" aria-valuemax={tasks.length} aria-valuenow="0"><i></i></div>
      <dl><div><dt>Current phase</dt><dd id="current-phase">—</dd></div><div><dt>Next deadline</dt><dd id="next-deadline">—</dd></div></dl>
      <button class="reset-button" id="reset-progress" type="button">Reset local progress</button>
      <p class="local-note">Saved only in this browser; the stable-ID redesign starts a clean v2 checklist.</p>
    </section>

    <section class="glance section-block" aria-labelledby="glance-title"><p class="eyebrow">AT A GLANCE</p><h2 id="glance-title">Five workstreams, one outcome</h2><div><article><b>Status</b><span>Three truthful candidate routes</span></article><article><b>Thai study</b><span>Required under every route</span></article><article><b>Cat</b><span>Cabin route through ICN and DAD</span></article><article><b>Tax</b><span>Depart 21 Oct · 177 Thai days</span></article><article><b>Location</b><span>Thailand → Korea → Viet Nam</span></article></div></section>

    <section id="decision" class="section-block">
      <p class="eyebrow">DECISION</p><h2>Build three real cases. Submit the strongest.</h2>
      <div class="candidate-context"><b>Candidate evidence routes</b><ol><li>DTV workcation</li><li>DTV cooking</li><li>Non-ED language</li></ol></div>
      <p>Prepare all three, obtain written answers, and let Integrity Legal compare practical approval likelihood. Learning Thai continues under every route.</p>
      <div class="decision-grid" role="list" aria-label="Application outcomes">
        <article class="decision-card issued"><b>Issued</b><span>Return to Bangkok on the issued status.</span></article>
        <article class="decision-card pending"><b>Pending</b><span>Stay in Viet Nam under the 90-day visa and wait.</span></article>
        <article class="decision-card refused"><b>Refused</b><span>Return visa-exempt, then promptly execute prepared TM.87.</span></article>
      </div>
    </section>

    <section class="route section-block"><div><p class="eyebrow">ROUTE GEOGRAPHY</p><h2>Thailand → Korea → Viet Nam → Thailand</h2><p>Return only after issuance, or visa-exempt after refusal to execute TM.87. Malaysia is not part of this plan.</p></div><img src="/thailand/asia-route-map.svg" alt="Route map from Bangkok through Seoul to Da Nang, then back to Bangkok after a visa decision." /></section>

    <section id="calendar" class="section-block calendar-section">
      <div class="section-heading"><div><p class="eyebrow">CALENDAR</p><h2>Deadlines and gates</h2><p id="today-context" class="today-context"></p></div><p><i class="legend current"></i> current month <i class="legend next"></i> next action <i class="legend done"></i> complete</p></div>
      <div class="calendar-board full-calendar" data-calendar>{phases.slice(0,5).map(phase => <section class="calendar-month" data-phase={phase.id}><h3>{phase.label}</h3><div>{events.filter(e=>e.phase===phase.id).map(e=><article tabindex="0" class="milestone" data-event-id={e.id} data-task-ids={eventTasks[e.id].join(' ')}><small>{e.date}</small><span>{e.label}</span><nav aria-label={`Tasks for ${e.label}`}>{eventTasks[e.id].map(id=><a href={`#task-${id}`} data-jump-task={id}>Jump to task</a>)}</nav></article>)}</div></section>)}</div>
      <div class="mobile-timeline" data-calendar>{events.map(e=><article tabindex="0" class="milestone" data-event-id={e.id} data-task-ids={eventTasks[e.id].join(' ')}><small>{e.date}</small><span>{e.label}</span><nav aria-label={`Tasks for ${e.label}`}>{eventTasks[e.id].map(id=><a href={`#task-${id}`} data-jump-task={id}>Jump to task</a>)}</nav></article>)}</div>
    </section>

    <nav class="section-nav" aria-label="Plan sections">{nav.map(([id,label])=><a href={`#${id}`} data-section-link={id}>{label}</a>)}</nav>

    <section class="task-tools" aria-label="Task filters"><div><b>Show</b><span id="visible-count">{tasks.length} tasks</span></div><div class="filter-row"><button type="button" data-filter="due-soon" aria-pressed="false">Due soon</button>{categories.map(([id,label])=><button type="button" data-filter={id} aria-pressed="false">{label}</button>)}<button type="button" data-filter="completed" aria-pressed="false">Done</button></div></section>
    <p id="filter-empty" class="filter-empty" hidden role="status">No tasks match these filters.</p>

    <div class="task-register">
      {phases.map(phase => <section class="task-phase" id={phase.id} data-phase-section={phase.id}><header><p class="eyebrow">{phase.id==='vietnam'?'NOVEMBER–DECEMBER':phase.label.toUpperCase()}</p><h2>{phase.label}</h2></header><div class="task-list">{tasks.filter(t=>t.phase===phase.id).map(task => <article class="task-card" id={`task-${task.id}`} tabindex="-1" data-task-id={task.id} data-due={task.due} data-categories={task.categories.join(' ')} data-event-ids={task.events.join(' ')} data-conditional={String(task.conditional)}><div class="task-main"><label class="checkbox-control"><input type="checkbox" data-task-checkbox={task.id}/><span class="checkmark" aria-hidden="true"></span><span class="sr-only">Mark task complete</span></label><div class="task-copy"><strong>{task.lead}:</strong> {task.action}</div></div>{(task.why||task.done)&&<details><summary title="Why and done when"><span class="info-icon" aria-hidden="true"></span><span class="sr-only">Why and done when</span></summary><div>{task.why&&<p><b>Why:</b> {task.why}</p>}<p><b>Done when:</b> {task.done}</p></div></details>}</article>)}</div></section>)}
    </div>
    <section class="section-block branches"><p class="eyebrow">BRANCH RULES</p><h2>What changes the plan</h2><div><article><b>Application issued</b><span>Return to Bangkok on it.</span></article><article><b>Application pending</b><span>Wait in Viet Nam; do not leave the application country.</span></article><article><b>DTV refused</b><span>Return visa-exempt and start the prepared TM.87 route promptly.</span></article><article><b>Da Nang cannot issue cat export papers</b><span>Use the SGN road fallback only with a weight-confirmed onward flight.</span></article></div><p class="research-note">Supporting research: Thai status without leaving Asia · Thailand tax residency and day count · Cat relocation within five hours of Bangkok.</p></section>
  </main>

  <aside class="calendar-dock" aria-label="Sticky calendar"><div class="dock-head"><a href="#calendar">View full calendar</a><span>All milestones · scroll calendar if needed</span><button type="button" id="collapse-dock" aria-expanded="true" aria-controls="sticky-calendar-board">Collapse</button></div><div id="sticky-calendar-board" class="calendar-board" data-calendar>{phases.slice(0,5).map(phase=><section class="calendar-month" data-phase={phase.id}><h3>{phase.label}</h3><div>{events.filter(e=>e.phase===phase.id).map(e=><article tabindex="0" class="milestone" data-event-id={e.id} data-task-ids={eventTasks[e.id].join(' ')}><small>{e.date}</small><span>{e.label}</span></article>)}</div></section>)}</div></aside>
  <button type="button" class="calendar-fab" id="open-calendar" aria-haspopup="dialog">Calendar · <span>now</span></button>
  <dialog id="calendar-sheet"><div class="sheet-head"><b>Plan calendar</b><button type="button" id="close-calendar">Close</button></div><div class="mobile-timeline" data-calendar>{events.map(e=><article tabindex="0" class="milestone" data-event-id={e.id} data-task-ids={eventTasks[e.id].join(' ')}><small>{e.date}</small><span>{e.label}</span><nav aria-label={`Tasks for ${e.label}`}>{eventTasks[e.id].map(id=><a href={`#task-${id}`} data-jump-task={id}>Jump to task</a>)}</nav></article>)}</div></dialog>

  <script is:inline define:vars={{ phases, taskIds: tasks.map(t=>t.id), eventTasks }}>
    const KEY='biohack.thailand.v2.'; const cards=[...document.querySelectorAll('[data-task-id]')]; const checks=[...document.querySelectorAll('[data-task-checkbox]')]; const active=new Set();
    const today=new Date(); today.setHours(0,0,0,0); const iso=today.toISOString().slice(0,10);
    const current=phases.find(p=>iso>=p.start&&iso<=p.end) || (iso<phases[0].start?phases[0]:phases[phases.length-1]);
    document.querySelectorAll(`[data-phase="${current.id}"]`).forEach(n=>n.classList.add('is-current')); document.querySelector('#open-calendar span').textContent=current.label; document.querySelector('#today-context').textContent=(iso>=phases[0].start&&iso<=phases[4].end)?`Today · ${today.toLocaleDateString(undefined,{day:'numeric',month:'short',year:'numeric'})} · ${current.label}`:`Today is ${iso<phases[0].start?'before':'after'} the displayed plan range.`;
    function stored(id){try{return localStorage.getItem(KEY+id)==='1'}catch{return false}} function save(id,value){try{localStorage.setItem(KEY+id,value?'1':'0')}catch{}}
    function update(){
      const done=new Set(checks.filter(c=>c.checked).map(c=>c.dataset.taskCheckbox));
      document.querySelector('#complete-count').textContent=done.size; const bar=document.querySelector('.progress-track'); bar.setAttribute('aria-valuenow',done.size); bar.querySelector('i').style.width=`${done.size/taskIds.length*100}%`;
      document.querySelector('#current-phase').textContent=current.label;
      document.querySelectorAll('[data-event-id]').forEach(el=>{const ids=(el.dataset.taskIds||'').split(' ').filter(Boolean), n=ids.filter(id=>done.has(id)).length; el.classList.toggle('is-complete',ids.length>0&&n===ids.length); el.classList.toggle('is-partial',n>0&&n<ids.length); el.setAttribute('aria-label',`${el.textContent.trim()}. ${n===ids.length?'Complete':n?'Partly complete':'Incomplete'}`)});
      const next=cards.filter(c=>!done.has(c.dataset.taskId)&&c.dataset.conditional!=='true').sort((a,b)=>a.dataset.due.localeCompare(b.dataset.due))[0]; document.querySelector('#next-deadline').textContent=next?`${next.dataset.due} · ${next.querySelector('strong').textContent.replace(':','')}`:'All actionable tasks complete';
      document.querySelectorAll('.milestone').forEach(n=>n.classList.remove('is-next')); if(next){(next.dataset.eventIds||'').split(' ').forEach(id=>document.querySelectorAll(`[data-event-id="${id}"]`).forEach(n=>n.classList.add('is-next')))} filter();
    }
    checks.forEach(c=>{c.checked=stored(c.dataset.taskCheckbox); c.addEventListener('change',()=>{save(c.dataset.taskCheckbox,c.checked); c.closest('.task-card').classList.toggle('is-done',c.checked); update()}); c.closest('.task-card').classList.toggle('is-done',c.checked)});
    function filter(){let shown=0; cards.forEach(c=>{const cats=c.dataset.categories.split(' '), due=(new Date(c.dataset.due+'T00:00:00')-today)/86400000, complete=c.querySelector('input').checked, wantsComplete=active.has('completed'), wantsDue=active.has('due-soon'); const matchesOther=[...active].filter(f=>f!=='completed'&&f!=='due-soon').every(f=>cats.includes(f)); const ok=wantsComplete?complete:wantsDue?!complete&&c.dataset.conditional!=='true'&&due>=0&&due<=30&&matchesOther:matchesOther; c.hidden=!ok; if(ok)shown++}); document.querySelector('#visible-count').textContent=`${shown} task${shown===1?'':'s'}`; const empty=document.querySelector('#filter-empty');empty.hidden=shown!==0;empty.textContent=active.has('completed')?'No completed tasks yet.':'No tasks match these filters.';document.querySelectorAll('.task-phase').forEach(s=>s.hidden=![...s.querySelectorAll('.task-card')].some(c=>!c.hidden)); document.querySelectorAll('.is-linked').forEach(n=>{if(n.hidden)n.classList.remove('is-linked')})}
    document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{const f=b.dataset.filter,turningOn=!active.has(f);if(f==='completed'&&turningOn){active.clear();document.querySelectorAll('[data-filter]').forEach(x=>x.setAttribute('aria-pressed','false'))}else if(f!=='completed'&&turningOn&&active.has('completed')){active.delete('completed');document.querySelector('[data-filter="completed"]').setAttribute('aria-pressed','false')}turningOn?active.add(f):active.delete(f);b.setAttribute('aria-pressed',String(active.has(f)));filter()}));
    function highlight(ids,on){cards.forEach(c=>c.classList.toggle('is-linked',on&&ids.includes(c.dataset.taskId))); document.querySelectorAll('[data-event-id]').forEach(e=>e.classList.toggle('is-linked',on&&ids.some(id=>(e.dataset.taskIds||'').split(' ').includes(id))))}
    document.querySelectorAll('.task-card').forEach(c=>{const ids=[c.dataset.taskId]; c.addEventListener('mouseenter',()=>highlight(ids,true)); c.addEventListener('mouseleave',()=>highlight(ids,false)); c.addEventListener('focusin',()=>highlight(ids,true)); c.addEventListener('focusout',()=>highlight(ids,false))});
    document.querySelectorAll('.milestone').forEach(m=>{const ids=(m.dataset.taskIds||'').split(' '); m.addEventListener('mouseenter',()=>highlight(ids,true));m.addEventListener('mouseleave',()=>highlight(ids,false));m.addEventListener('focusin',()=>highlight(ids,true));m.addEventListener('focusout',()=>highlight(ids,false))}); document.querySelectorAll('[data-jump-task]').forEach(link=>link.addEventListener('click',e=>{e.preventDefault();document.querySelectorAll('[data-filter][aria-pressed="true"]').forEach(b=>{b.setAttribute('aria-pressed','false');active.delete(b.dataset.filter)});filter();const target=document.querySelector(`#task-${link.dataset.jumpTask}`);document.querySelector('#calendar-sheet')?.open&&document.querySelector('#calendar-sheet').close();target?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'});target?.focus()}));
    document.querySelector('#reset-progress').addEventListener('click',()=>{if(confirm('Reset every locally saved checkbox?')){checks.forEach(c=>{c.checked=false;try{localStorage.removeItem(KEY+c.dataset.taskCheckbox)}catch{}c.closest('.task-card').classList.remove('is-done')});update()}});
    const full=document.querySelector('#calendar'), dock=document.querySelector('.calendar-dock'), register=document.querySelector('.task-register'), opener=document.querySelector('#open-calendar'); const io=new IntersectionObserver(()=>{const r=register.getBoundingClientRect(),f=full.getBoundingClientRect(),inside=r.top<innerHeight&&r.bottom>0;dock.classList.toggle('show',f.bottom<0&&inside);opener.classList.toggle('show',inside)});io.observe(full);io.observe(register);const dockToggle=document.querySelector('#collapse-dock');dockToggle.addEventListener('click',()=>{const collapsed=dock.classList.toggle('collapsed');dockToggle.textContent=collapsed?'Expand':'Collapse';dockToggle.setAttribute('aria-expanded',String(!collapsed))});
    const dialog=document.querySelector('#calendar-sheet');opener.addEventListener('click',()=>dialog.showModal());document.querySelector('#close-calendar').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>opener.focus());
    const sectionObserver=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){document.querySelectorAll('[data-section-link]').forEach(a=>a.classList.toggle('active',a.dataset.sectionLink===e.target.id))}}),{rootMargin:'-20% 0px -70%'});document.querySelectorAll('[data-section-link]').forEach(a=>{const n=document.getElementById(a.dataset.sectionLink);if(n)sectionObserver.observe(n)});
    update();
  </script>
</Base>

<style is:global>
  body{max-width:none;padding:0;background:#0d1621;color:#f4f1e8}.plan-shell{width:min(1180px,calc(100% - 40px));margin:auto;padding:48px 0 120px}.hero{padding:55px 0 40px;scroll-margin-top:90px}.eyebrow{font:500 .72rem var(--font-mono);letter-spacing:.15em;color:#ff805d}.hero h1{font-size:clamp(3rem,8vw,6.5rem);line-height:.9;letter-spacing:-.06em;max-width:850px}.lede{font-size:clamp(1.15rem,2vw,1.5rem);max-width:850px;color:#c9d4df;margin-top:28px}.status-row,.candidates{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.status-row{gap:0;border-block:1px solid #2d4255;width:max-content;max-width:100%;padding-block:10px}.status-row div{display:flex;gap:7px;padding:0 18px;border-left:1px solid #2d4255}.status-row div:first-child{padding-left:0;border-left:0}.status-row dt{font:500 .72rem var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:#8195a7}.status-row dd{color:#dbe7ef;font-weight:650}.candidates span{border:1px solid #34475a;background:#142333;padding:7px 12px;border-radius:999px;color:#dbe7ef}.progress-card,.section-block,.task-tools{background:#111f2d;border:1px solid #2d4255;border-radius:18px;padding:24px;margin:20px 0}.progress-card{display:grid;grid-template-columns:1fr 2fr;gap:14px 30px;align-items:center;position:relative}.progress-track{height:12px;background:#26384a;border-radius:99px;overflow:hidden}.progress-track i{display:block;height:100%;background:#ff6847}.progress-card dl{display:flex;gap:35px}.progress-card dt{font-size:.75rem;color:#90a2b3}.progress-card dd{font-weight:700}.text-button,.dock-head button,.sheet-head button{color:#ff8c6c;background:none;border:0;text-decoration:underline;cursor:pointer}.local-note{font-size:.75rem;color:#90a2b3}.section-block{scroll-margin-top:80px}.section-block h2,.task-phase h2{font-size:clamp(1.6rem,3vw,2.5rem);line-height:1.1;margin:6px 0 16px}.glance>div,.branches>div{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.glance article,.branches article{display:grid;gap:5px;background:#172838;border:1px solid #33495b;border-radius:10px;padding:14px}.glance article span,.branches article span,.research-note{color:#aebdca;font-size:.86rem}.branches>div{grid-template-columns:repeat(4,1fr)}.research-note{margin-top:15px}.decision-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:25px}.decision-card{padding:20px;border-radius:12px;display:grid;gap:6px;color:#fff}.decision-card b{font-size:1.35rem}.issued{background:#176f64}.pending{background:#765b12}.refused{background:#813842}.route{display:grid;grid-template-columns:1fr 1.35fr;gap:25px;align-items:center}.route img{width:100%;border-radius:12px;background:#0b121b}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px}.section-heading>p{font-size:.78rem;color:#9fb0c0}.today-context{color:#b6c4d0}.legend{display:inline-block;width:9px;height:9px;border-radius:50%;margin-left:10px}.legend.current{background:#8c6fff}.legend.next{background:#ffb248}.legend.done{background:#43c6a4}.calendar-board{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:#2b3d4e;border:1px solid #2b3d4e;border-radius:12px;overflow:hidden;margin-top:20px}.calendar-month{background:#0d1925;padding:12px;min-width:0}.calendar-month.is-current{background:#15243a;box-shadow:inset 0 3px #8c6fff}.calendar-month h3{font:500 .75rem var(--font-mono);text-transform:uppercase;margin-bottom:10px}.calendar-month>div{display:grid;gap:8px}.milestone{appearance:none;text-align:left;background:#192a39;color:#f4f1e8;border:1px solid #364b5e;border-radius:8px;padding:8px;cursor:pointer;min-width:0}.milestone small{display:block;color:#ff9c7e}.milestone span{font-weight:600}.milestone em{display:none;font-size:.68rem;color:#a7e8d4}.milestone:hover em,.milestone:focus em{display:block}.milestone.is-next{outline:2px solid #ffb248;outline-offset:2px}.milestone.is-complete{background:#153a35;border-color:#43c6a4;opacity:.78}.milestone.is-complete span{text-decoration:line-thro